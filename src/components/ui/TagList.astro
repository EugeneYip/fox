---
import { localizePath, useTranslations } from '@i18n/utils';
import { tagSlug } from '@lib/content';
import type { Locale } from '@config/site';

interface Props {
  tags: string[];
  locale: Locale;
  max?: number;
}
const { tags, locale, max } = Astro.props;
const t = useTranslations(locale);
/*
 * ── 標籤連結為什麼要有 aria-label ────────────────────
 *
 * 第 1 輪（第十八圈）從讀者那一側量：螢幕閱讀器的「連結清單」會把連結
 * 抽出來排在一起、沒有上下文。標籤連結叫「詩詞」，而導覽列也有一個
 * 叫「詩詞」的連結（去 /poems）—— 清單裡兩個一模一樣的名字、不同的去處。
 *
 * 用既有的 tags.taggedWith 唸成「標記為「詩詞」」：分得開，也講得出這是什麼。
 * 畫面上的字沒有變。
 */
const shown = max ? tags.slice(0, max) : tags;
const overflow = max && tags.length > max ? tags.length - max : 0;
---

{shown.length > 0 && (
  <ul class="taglist ui">
    {shown.map((tag) => (
      <li>
        <a
          href={localizePath(`/tags/${encodeURIComponent(tagSlug(tag))}`, locale)}
          aria-label={t('tags.taggedWith', { tag })}
        >{tag}</a>
      </li>
    ))}
    {overflow > 0 && <li class="taglist__more">+{overflow}</li>}
  </ul>
)}

<style>
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .taglist li { margin: 0; }

  /*
   * ── 標籤改成「籤條」──────────────────────────────
   *
   * 本來是四周描邊的圓角膠囊 —— 那是一般網站的形狀，跟這個站
   * 其他地方（髮絲線、方角的版框）不是同一套語彙，而且一排圓角
   * 泡泡在一頁紙的下方特別吵。
   *
   * 改成夾在書裡的紙籤：方角、左邊一道書口似的粗線、底色比紙沉一點。
   * 描邊四條變一條，一排標籤就從「一串泡泡」變成「一疊書籤」。
   *
   * 對比算過（--c-ink-soft 在 --c-bg-sunken 上）：淺色 6.78:1、
   * 深色 8.09:1，兩套都過 AA 的 4.5。滑過去換成狐火那一組
   * （--c-flame-ink 在 --c-flame-wash 上），那一組是 /archive 的
   * 類型標記本來就在用的，已經在 check:contrast 的清單裡。
   */
  .taglist a {
    display: inline-block;
    font-size: var(--t-xs);
    padding: 0.2em 0.7em;
    border: 0;
    /*
     * 邊上那一道用苔色。tokens.css 給 --c-moss 寫的用途就是
     * 「青綠，用在次要標記」，而在這之前它只出現在一個從來沒有算繪過的
     * 地方（手動登錄的來源標記，站上 0 筆）—— 調色盤上有一個顏色
     * 定義好了卻沒有在用。
     *
     * 也刻意不用狐火：狐火是結構的顏色（魚尾、當前頁、重點連結），
     * 標籤是次要的。兩種紅橘色的東西擠在同一張卡片上會互相搶。
     */
    border-inline-start: 2px solid var(--c-moss);
    border-radius: 0;
    background: var(--c-bg-sunken);
    color: var(--c-ink-soft);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .taglist a:hover,
  .taglist a:focus-visible {
    border-inline-start-color: var(--c-flame);
    background: var(--c-flame-wash);
    color: var(--c-flame-ink);
  }

  .taglist__more {
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    align-self: center;
  }
</style>
