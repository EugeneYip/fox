---
/**
 * 站內文章的列表項。
 *
 * 三種內容（文章／詩詞／短札）共用同一個卡片，只用一個小標記區分類型。
 * 讓時間軸看起來是連續的，而不是三個各自為政的清單。
 */
import type { AnyEntry, WritingCollection } from '@lib/content';
import { entryUrl, transitionName } from '@lib/content';
import { formatDate, isoDate } from '@lib/dates';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@config/site';
import TagList from '@components/ui/TagList.astro';

interface Props {
  collection: WritingCollection;
  entry: AnyEntry;
  locale: Locale;
  /** 顯示類型標記；同質的列表頁可以關掉 */
  showType?: boolean;
  /**
   * 標題要用哪一級。
   * 這不是樣式問題 —— 螢幕閱讀器靠標題層級建立頁面大綱，跳級（h1 直接到 h3）
   * 會讓大綱出現斷層。
   *   首頁：上面有 h2 的「最近」，所以卡片用 h3
   *   列表頁：h1 底下直接就是卡片，要用 h2
   */
  headingLevel?: 'h2' | 'h3';
}

const { collection, entry, locale, showType = true, headingLevel = 'h3' } = Astro.props;
// 注意：這個 prop 不能叫 `as` —— `as` 是 TypeScript 的運算子關鍵字，
// 拿來當 prop 名稱會讓 Astro 推不出 Props 型別，Astro.props 整個變成 any。
const Heading = headingLevel;
const t = useTranslations(locale);

const typeLabel = {
  posts: t('type.post'),
  poems: t('type.poem'),
  notes: t('type.note'),
}[collection];

const href = entryUrl(collection, entry);
const data = entry.data;

// 詩詞的摘要用詩題與作者，比用 description 更有資訊量
const poem = 'poem' in data ? data.poem : undefined;
const subtitle = poem ? `${poem.author}${poem.dynasty ? `・${poem.dynasty}` : ''}` : undefined;

/*
 * ── 詩的形狀 ────────────────────────────────────────
 *
 * 2026-09-11 量到的問題：`/poems` 十一列長得一模一樣（標題／日期／一句描述／
 * 四個標籤），**一個字的詩都沒有** —— 這是詩詞站的列表頁。
 *
 * 所以每一列帶一格「格律」：句數 × 每句字數，畫成一個小方格陣。
 * 一眼分得出絕句（4 句）、律詩（8 句）、樂府（更長），
 * 以及五言與七言。那是資訊，不是裝飾。
 *
 * **不新增欄位**：直接數 `poem.original`。站上十一首全部解析乾淨
 *（4×5 兩首、4×7 六首、8×5 兩首、10×7 一首）。
 * 標點不算 —— 格律算的是字，而〈琵琶行〉的原文裡有逗號。
 *
 * 直排的詩是「由右往左一句一句」，所以**欄數 ＝ 句數、列數 ＝ 每句字數**，
 * 跟詩頁上那個版框同一個方向。
 */
const shapeLines = poem?.original
  ? poem.original
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
  : [];
const shapeCols = shapeLines.length;
const shapeRows = shapeLines.length
  ? Math.max(...shapeLines.map((line) => [...line].filter((c) => !/[，。、；：！？「」『』（）]/.test(c)).length))
  : 0;
---

<article class="entry">
  <div class="entry__body">
    <a class="entry__link" href={href}>
      <Heading
        class="entry__title"
        data-featured={data.featured ? '' : undefined}
        style={`view-transition-name:${transitionName(collection, entry.id)}`}
      >
        {poem ? poem.title : data.title}
      </Heading>
    </a>

    <div class="entry__meta ui">
      <time datetime={isoDate(data.publishedAt)}>{formatDate(data.publishedAt, locale)}</time>
      {showType && <><span aria-hidden="true">·</span><span>{typeLabel}</span></>}
      {subtitle && <><span aria-hidden="true">·</span><span>{subtitle}</span></>}
    </div>

    {data.description && <p class="entry__desc muted">{data.description}</p>}

    <TagList tags={data.tags} locale={locale} max={4} />
  </div>

  {/*
    aria-hidden：格律已經以文字的形式在標籤裡（「五言絕句」），
    這一格是同一件事的第二種說法，讀出來只會變成噪音。
  */}
  {shapeCols > 0 && shapeRows > 0 && (
    <span
      class="entry__shape"
      aria-hidden="true"
      style={`--shape-cols:${shapeCols};--shape-rows:${shapeRows}`}
    />
  )}
</article>

<style>
  /*
   * 這一層是橫的：左邊是原本那一疊東西，右邊是「詩的形狀」。
   *
   * 本來想用 grid ＋ `.entry > * { grid-column: 1 }`，**那一版是錯的**，
   * 兩個原因疊在一起，而且都跟 Astro 的 scoped CSS 有關：
   *
   *   1. `TagList` 是另一個元件，**它的根元素帶的是別的 cid**，
   *      所以 `.entry > *`（會被改寫成 `.entry[cid] > *[cid]`）配不到它 ——
   *      它被自動排到第二軌，跟描述並排。
   *   2. `.entry > *` 改寫後是 `.entry[cid] > *[cid]`，兩個屬性選擇器，
   *      **特異性比 `.entry__shape[cid]` 高**，於是形狀也被壓回第一軌。
   *
   * 包一層 `.entry__body` 就兩個問題都沒有了，代價是每一列多一個 div。
   */
  .entry {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-block-end: var(--border-thin);
    /* 跟 /彙整 的列同一個做法：底色往外咬一點，對齊線不動 */
    padding-inline: var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    border-radius: var(--r-md);
    transition: background var(--dur-fast) var(--ease);
  }

  /* 整篇有回應（`:focus-within` 讓鍵盤也拿得到同一個回饋） */
  .entry:hover,
  .entry:focus-within {
    background: var(--c-bg-sunken);
  }

  .entry:last-child { border-block-end: 0; }

  .entry__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    /* 不加這個的話，長的描述會把這一項撐開、把形狀擠出去 */
    min-inline-size: 0;
    flex: 1;
  }

  /*
   * ── 那一格方格陣 ──────────────────────────────────
   *
   * 用兩道 repeating gradient 畫，**沒有任何子元素** ——
   * 一首七言絕句是 4 × 7 ＝ 28 格，十一列就是 308 個元素，
   * 而 HTML 的預算只剩 3.1 KB。漸層讓每一列只多一個 span。
   *
   * 外框用 `--c-rule-strong`、格線用 `--c-rule`，跟詩頁上的
   * 版框（外粗內細）與界欄是同一套說法。角是方的，理由同版框。
   */
  .entry__shape {
    flex: none;
    inline-size: calc(var(--shape-cols) * var(--shape-cell));
    block-size: calc(var(--shape-rows) * var(--shape-cell));
    --shape-cell: 7px;
    border: 1px solid var(--c-rule-strong);
    background-image:
      repeating-linear-gradient(
        to right,
        var(--c-rule) 0 1px,
        transparent 1px var(--shape-cell)
      ),
      repeating-linear-gradient(
        to bottom,
        var(--c-rule) 0 1px,
        transparent 1px var(--shape-cell)
      );
    transition: border-color var(--dur-fast) var(--ease);
  }

  /* 整列有回應時這一格也跟著 —— `:focus-within` 是鍵盤的那一半 */
  .entry:hover .entry__shape,
  .entry:focus-within .entry__shape {
    border-color: var(--c-flame);
  }

  /* 窄螢幕收起來：那裡橫向的每一格都要省 */
  @media (max-width: 34rem) {
    .entry__shape { display: none; }
  }

  .entry__link { text-decoration: none; }

  /*
   * `--t-lg` 不是 `--t-md`：2026-09-11 量過整站的字級分布，
   * 60 次用量擠在最小的兩級，而這個標題（20px）跟頁面引言、跟頁首的站名
   * **一樣大** —— 一頁 11 列長得完全一樣，要點的那個東西沒有領先。
   * 數字與整段推導在 docs/VISUAL.md。
   */
  .entry__title {
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: var(--lh-snug);
    transition: color var(--dur-fast) var(--ease);
  }

  .entry__link:hover .entry__title { color: var(--c-flame-ink); }

  /*
   * 置頂的星號。原本是 `<span aria-hidden="true">✦</span>` 放在標題**裡面**。
   *
   * 第 1 輪（第十一圈）做過控制實驗：`aria-hidden` 會被排除在**連結**的
   * 可及名稱之外，但**標題**的名稱仍然含著它（那是瀏覽器還是工具的行為，
   * 那一輪查不出來，所以只記著沒有當成發現）。同一輪也量到另一件事：
   * **CSS `::after` 產生的內容不會進到可及名稱裡**（量過三頁，一個都沒有）。
   *
   * 第 1 輪（第十二圈）用標題導覽讀了一次全站的大綱，那個星號就出現在
   * 「靜夜思✦」裡 —— 而標題導覽正好是那個不確定性會咬到的地方。
   * 改用 `::after` 之後，兩種解釋下它都不在名稱裡，而畫面完全沒有變。
   *
   * （這個星號本身不承載資訊 —— 第 1 輪〔第十一圈〕查過，`featured`
   * 只影響排序。所以拿掉它的發音不會遺失任何東西。）
   */
  .entry__title[data-featured]::after {
    content: "✦";
    color: var(--c-flame);
    font-size: 0.7em;
    vertical-align: 0.3em;
    margin-inline-start: 0.3em;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  /* 摘要是會換行的中文段落（390px 下 6 段有 5 段換行），所以用 --lh-body */
  .entry__desc {
    max-inline-size: 62ch;
    line-height: var(--lh-body);
  }
</style>
