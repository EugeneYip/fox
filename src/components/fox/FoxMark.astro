---
/**
 * 狐狸標記 —— 全站唯一的圖形符號。
 *
 * 幾何化的狐狸頭，用最少的線條交代耳朵、臉、眼睛。
 * 用 currentColor，所以放在哪裡就跟著那裡的文字顏色走，
 * 深淺色主題都不用另外處理。
 *
 * 注意：Astro 的 scoped style 不會穿進子元件，所以在外面寫
 * `<FoxMark class="x" />` 搭配 `.x { color: ... }` 是沒有用的。
 * 要換顏色請包一層容器，把 color 設在容器上，讓它繼承下來。
 */
import { FOX_HEAD, FOX_EYE_L, FOX_EYE_R, FOX_NOSE, FOX_VIEWBOX } from '@config/fox-mark';

interface Props {
  size?: number | string;
  /** 'solid' 實心，適合小尺寸與 favicon；'line' 線條，適合大尺寸 */
  variant?: 'solid' | 'line';
  /** 有意義的圖才給 title；純裝飾留空會自動加 aria-hidden */
  title?: string;
  class?: string;
}

const { size = 40, variant = 'solid', title, class: className } = Astro.props;
const decorative = !title;
---

<svg
  class:list={['fox-mark', `fox-mark--${variant}`, className]}
  width={size}
  height={size}
  viewBox={`0 0 ${FOX_VIEWBOX} ${FOX_VIEWBOX}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
>
  {title && <title>{title}</title>}

  {variant === 'solid' ? (
    <>
      <path d={FOX_HEAD} fill="currentColor" />
      {/* 眼睛與鼻頭用底色挖空，這樣不管背景是什麼顏色都乾淨 */}
      <path d={FOX_EYE_L} fill="var(--c-bg)" />
      <path d={FOX_EYE_R} fill="var(--c-bg)" />
      <path d={FOX_NOSE} fill="var(--c-bg)" />
    </>
  ) : (
    <>
      <path d={FOX_HEAD} stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
      <path d={FOX_EYE_L} fill="currentColor" />
      <path d={FOX_EYE_R} fill="currentColor" />
      <path d={FOX_NOSE} fill="currentColor" />
    </>
  )}
</svg>

<style>
  .fox-mark {
    flex: none;
    /*
     * 牠本來就歪著頭，游標移過去才挺起來。
     *
     * 站主 2026-09-09 選的方向：**靜止的畫面就已經有表情**，
     * 而不是要等人把游標移過去才有。上一版是反過來的（靜止端正、
     * 滑過去才歪 −4°），所以沒有游標的人（手機、鍵盤）從來沒看過那個巧思。
     *
     * 這個 rotate 轉的是整個 `<svg>` 元素，不是 viewBox 裡的內容，
     * 所以跟格子裡留多少邊界無關 —— 真正要小心的是**祖先有沒有
     * `overflow: hidden`**。頁首那條捲動帶是第 8 輪（第五十四圈）拿掉的，
     * 現在沒有人會裁到它；哪天又有人加回去，先量一次再說。
     *
     * 靜止的傾斜不是動效，所以 prefers-reduced-motion 不用關掉它 ——
     * global.css 已經把 transition-duration 壓成 0.01ms，
     * 那會讓它直接切換而不是滑過去，正好是要的。
     */
    transform: rotate(-5deg);
    transition: transform var(--dur) var(--ease);
  }

  @media (hover: hover) {
    :global(a:hover) > .fox-mark,
    :global(button:hover) > .fox-mark {
      transform: rotate(0deg) scale(1.06);
    }
  }
</style>
