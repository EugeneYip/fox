---
/**
 * 詩詞展示。
 *
 * 這是全站最花心思的元件，因為它是「狐說八道」的本體。
 *
 * 直排是預設。中文詩詞本來就是直著寫、右起左行的，直排讀起來
 * 節奏對、斷句自然。但直排在窄螢幕上會變成要橫向捲動，所以
 * 48rem 以下自動切回橫排（CSS 處理，不需要 JS）。
 * 使用者也可以手動切換，選擇會被記住。
 */
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@config/site';

interface Annotation { term: string; gloss: string }

interface Props {
  poem: {
    title: string;
    author: string;
    dynasty?: string;
    form?: string;
    source?: string;
    original: string;
  };
  plain?: string;
  annotations?: Annotation[];
  vertical?: boolean;
  locale: Locale;
}

const { poem, plain, annotations = [], vertical = true, locale } = Astro.props;
const t = useTranslations(locale);

// 空行分段，單行斷句 —— 讓 frontmatter 裡的原文格式直接決定排版
const stanzas = poem.original
  .trim()
  .split(/\n{2,}/)
  .map((block) => block.split('\n').map((line) => line.trim()).filter(Boolean))
  .filter((block) => block.length > 0);

/*
 * 直排的詩是往左邊長的，長到超出容器時靠外層橫向捲動 —— 螢幕上沒問題，
 * 但**紙上沒有捲軸**，超出的部分不是捲不到，是根本不會被印出來，
 * 而且讀的人完全不會知道少了東西。
 *
 * 第 8 輪（第五圈）實測（20 句的測試詩、CSSOM 把 @media print 改成 all）：
 *
 *   列印版面寬 717px（A4 直式 + Chrome 預設邊界）→ 橫排，645px，沒截斷
 *   列印版面寬 780px                              → 直排，容器 702、內容 1035，**截掉 333px**
 *   列印版面寬 1046px（A4 橫式）                   → 直排，容器 736、內容 1114，**截掉 378px**
 *
 * 容器在 1046px 的紙上仍然只有 736px —— 被 --w-content（46rem）鎖住，
 * 所以**門檻跟紙張大小無關**，固定在 736 ÷ 每句 56px ≈ 13 句。
 *
 * 第 2 輪（第十二圈）補量了一件那時候沒問的事：**這個數字跟字型有沒有關係？**
 * 直排時「每句的寬度」就是 line-height，而 `line-height: 2.1` 是**無單位的
 * 倍數**（乘字級，不是乘字型的度量），加上中文字在這些字型裡都是全形（1em），
 * 所以答案是**沒有關係**。實測六種字型（Songti TC／Songti SC／STSong／
 * Hiragino Mincho ProN／PingFang TC／generic serif）：
 *
 *   每句 55.37px、內容總寬 618px、容器放得下 13.29 句 —— 六個一模一樣
 *
 * 也就是說 56 ≈ 55.37，而 13 句這個門檻在換字型時不會漂移。
 *
 * 順帶記下量測的條件（這個 repo 反覆學到的事：留數字也要留條件）：
 * 那台機器的 `--f-serif` 實際落在**第三順位的 Songti TC** ——
 * Noto Serif TC 與 Source Han Serif TC 都沒有裝。用畫布把「衣」畫出來
 * 比對像素才問得出這件事：`document.fonts.check()` 對每一個字型都回 true，
 * 而「換兩個 generic 比寬度」的常用招數對中文無效（兩個 generic 會落到
 * 同一個系統字型）。
 *
 * 小於 768px 的版面被下面 @media (max-width: 48rem) 的「窄螢幕一律橫排」
 * 救到了，這也是為什麼 A4 直式印起來是好的、這個 bug 一直沒被看見。
 * 一旦是橫式、大一點的紙、或使用者把邊界調小，就會踩到。
 *
 * 所以超過門檻的詩在列印時退回橫排：橫排是往下長的，會自然分頁，不會掉字。
 * 目前站上最長的詩是 10 句，還沒踩到 —— 但註解裡點名的〈長恨歌〉有 120 句。
 */
const PRINT_VERTICAL_MAX_LINES = 13;
const lineCount = stanzas.reduce((n, block) => n + block.length, 0);
const printOverflows = lineCount > PRINT_VERTICAL_MAX_LINES;

/*
 * 最長的一句有幾個字 —— 直排時這決定「一行至少要多長，句子才不會被折斷」。
 *
 * 第 8 輪（第十二圈）實測到的問題：一行的長度上限是 `min(21rem, 52vh)`，
 * 而 52vh 在**橫放的手機**上很小。812×375（iPhone X／12 mini 這一代橫放，
 * 812 > 768 所以走的是直排）：上限 195px，而一句七言需要 199px ——
 * 差 4px，於是〈烏衣巷〉四句**每一句都折成兩截**、〈琵琶行〉十句全折。
 * 五言的〈靜夜思〉剛好躲過。折斷的七言看起來像另一種格律，不是排版瑕疵
 * 而已。
 *
 * 用字數算得出來：中文字是全形（1em），letter-spacing 0.14em 每個字後面
 * 都加，所以 N 個字佔 N × 1.14em。實測 7 字 ＋ 字級 24.884px＝199px，
 * 算出來 198.5px，對得上。
 *
 * 用 [...] 展開而不是 .length：古典詩詞會用到 BMP 以外的罕用字，
 * .length 會把那種字算成兩個。
 */
const longestLine = Math.max(...stanzas.flat().map((line) => [...line].length));
---

{/* 有名字的 section 才是有用的地標；沒有名字的話地標清單裡會出現一堆「region」 */}
<section
  class="poem"
  aria-label={t('poem.region', { title: poem.title })}
  data-default-orientation={vertical ? 'vertical' : 'horizontal'}
  data-print-overflows={printOverflows ? 'true' : undefined}
>
  <header class="poem__head">
    <h1 class="poem__title">〈{poem.title}〉</h1>
    <p class="poem__byline ui">
      {poem.dynasty && <span>{poem.dynasty}</span>}
      <span class="poem__author">{poem.author}</span>
      {poem.form && <span class="faint">{poem.form}</span>}
    </p>

    {/*
      按鈕上「看得見的字」是要切換去的模式（直排時顯示「橫排」），
      但螢幕閱讀器需要知道的是**現在是什麼**加上**按下去會怎樣**。

      原本這裡是 aria-pressed={vertical}：直排時 pressed=true，可是可及名稱
      取自可見文字「橫排」，於是唸出來是「橫排、切換鈕、已按下」——
      名稱與狀態互相矛盾，剛好講反。

      改成跟主題切換鈕同一個做法：動態 aria-label 說清楚，並拿掉 aria-pressed
      （這是模式切換，不是開關，pressed 的語意本來就套不上）。
    */}
    <button
      class="poem__toggle ui"
      type="button"
      data-poem-toggle
      aria-label={vertical ? t('poem.nowVertical') : t('poem.nowHorizontal')}
      data-label-vertical={t('poem.nowVertical')}
      data-label-horizontal={t('poem.nowHorizontal')}
    >
      <span aria-hidden="true" data-when="vertical">{t('poem.horizontal')}</span>
      <span aria-hidden="true" data-when="horizontal">{t('poem.vertical')}</span>
    </button>
  </header>

  {/*
    版框 —— 木刻本書葉四周的那圈框線。這一層只負責畫框，
    捲動與遮罩仍然在裡面那一層（見 .poem__scroll 的說明）。
  */}
  <div class="poem__frame">
    <div class="poem__scroll">
      <div class="poem__original" lang="zh-Hant" style={`--poem-longest-line:${longestLine}`}>
        {stanzas.map((lines) => (
          <p class="poem__stanza">
            {lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                <span class="poem__line">{line}</span>
              </>
            ))}
          </p>
        ))}
      </div>
    </div>
  </div>

  {poem.source && <p class="poem__source faint ui">{poem.source}</p>}

  {annotations.length > 0 && (
    <div class="poem__section">
      <h2 class="poem__section-title ui">{t('poem.notes')}</h2>
      <dl class="poem__annotations">
        {annotations.map((a) => (
          <div class="poem__annotation">
            <dt>{a.term}</dt>
            <dd>{a.gloss}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}

  {plain && (
    <div class="poem__section">
      <h2 class="poem__section-title ui">{t('poem.plain')}</h2>
      <p class="poem__plain">{plain}</p>
    </div>
  )}
</section>

<style>
  .poem {
    --poem-orientation: vertical;
  }

  .poem__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    text-align: center;
    margin-block-end: var(--s-6);
  }

  .poem__title {
    font-size: var(--t-xl);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .poem__byline {
    display: flex;
    gap: var(--s-3);
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .poem__author { font-weight: 600; }

  .poem__toggle {
    margin-block-start: var(--s-2);
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    /* 這是按鈕，邊界要看得出來 */
    border: 1px solid var(--c-edge);
    border-radius: 999px;
    padding: 0.2em 0.9em;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .poem__toggle:hover {
    color: var(--c-flame-ink);
    border-color: var(--c-flame);
  }

  /* 按鈕上顯示的是「切換到哪個模式」，所以跟目前狀態相反 */
  .poem__toggle [data-when="horizontal"] { display: none; }

  .poem[data-orientation="horizontal"] .poem__toggle [data-when="vertical"] { display: none; }
  .poem[data-orientation="horizontal"] .poem__toggle [data-when="horizontal"] { display: inline; }

  /* ── 原文 ───────────────────────────────────────── */

  /*
   * ── 版框：四周雙邊 ────────────────────────────────
   *
   * 木刻本的書葉四周有一圈框線，外粗內細的叫「四周雙邊」。
   * 這一首詩是整頁的中心，而它本來是浮在頁面底色上的 ——
   * 什麼都沒有托著它。框起來之後它讀起來才像**一葉書**。
   *
   * 角是方的（`border-radius: 0`）。這個站其他地方都是 --r-md 的圓角，
   * 這裡刻意不是：刻版上的框線沒有圓角，而那正是它認得出來的地方。
   *
   * 框畫在外面這一層、捲動留在裡面那一層，是為了不去動
   * `.poem__scroll` 的四層背景 —— 那組遮罩的顏色必須跟**框裡的底色**
   * 一模一樣，差一點就會出現一條看得見的帶子。
   * 框沒有自己的底色，所以那個前提還是成立。
   */
  .poem__frame {
    border: 1px solid var(--c-rule-strong);
    border-radius: 0;
    /* 兩條框線之間的空隙 —— 刻本上那一道也是這麼窄 */
    padding: 4px;
    /*
     * 框要**貼著詩**，不是貼著欄寬。
     *
     * 一葉書的框線圈住的是字，不是整張紙。用 fit-content 讓短詩的框
     * 收到詩的大小（〈登鸛雀樓〉是一個小方塊、〈月夜〉是一個橫長方塊），
     * 再用 max-inline-size 讓長到放不下的詩把框撐到滿版 ——
     * 那時候捲動仍然發生在裡面那一層，遮罩與影也還在。
     */
    inline-size: fit-content;
    max-inline-size: 100%;
    margin-inline: auto;
  }

  .poem__frame > .poem__scroll {
    border: 1px solid var(--c-rule);
  }

  .poem__scroll {
    /* 直排時內容往左邊長出去，需要能橫向捲動 */
    overflow-x: auto;
    overflow-y: hidden;

    /*
     * ── 捲得動的時候，邊緣浮出一道很淡的影 ────────────────
     *
     * 2026-09-09 給橫排補上「一句不能折」的下限之後，字級夠大時整塊會超出
     * 容器、改由這裡橫向捲。實測 360px 視窗：200% 字級要捲 25px、
     * 250% 要捲 122px。**而畫面上沒有任何東西說得出「還有」**
     * （`scrollbar-width: thin` 在手機上根本不顯示）。
     *
     * 做法是四層背景，不是 JavaScript —— 內嵌 JS 那條預算只剩 89 B，
     * 而且這件事本來就不需要腳本。
     *
     *   前兩層「遮罩」：`local`，跟著**內容**走
     *   後兩層「影」：  `scroll`，釘在**容器**上
     *
     * 捲到最左邊時，左邊的遮罩正好蓋住左邊的影 —— 看不見。
     * 一往右捲，遮罩跟著內容離開，影就露出來了。右邊同理。
     * **完全不會溢出的時候兩邊都被蓋住**，所以不用去偵測「捲不捲得動」。
     *
     * 遮罩用 `--c-bg`（詩塊底下就是頁面底色），影用 `--c-rule`（髮絲線那個色）
     * —— 兩個都是 light-dark() 的 token，深淺兩套各自對。
     */
    background-image:
      linear-gradient(to right, var(--c-bg), transparent),
      linear-gradient(to left, var(--c-bg), transparent),
      linear-gradient(to right, var(--c-rule), transparent),
      linear-gradient(to left, var(--c-rule), transparent);
    background-position: left center, right center, left center, right center;
    background-size: 2rem 100%, 2rem 100%, 0.75rem 100%, 0.75rem 100%;
    background-repeat: no-repeat;
    background-attachment: local, local, scroll, scroll;
    padding-block: var(--s-4);
    /*
     * 左右也要留一點氣口，字不要貼著內框那條線。
     * 遮罩與影的位置是對著 padding box 算的，所以加了內距它們仍然
     * 蓋在內容區的兩端上 —— 窄螢幕捲動時實測過。
     */
    padding-inline: var(--s-4);
    scrollbar-width: thin;
    display: flex;
  }

  .poem__original {
    writing-mode: vertical-rl;
    text-orientation: mixed;

    /*
     * 直排時軸向會反過來，這裡很容易寫錯：
     *   inline 軸是「垂直」的 —— 字往下流，所以 inline-size 是一行的「長度」（高度）
     *   block  軸是「水平」的 —— 新的一行往左疊，所以 block-size 是整體的寬度
     *
     * 因此限制的是 max-inline-size：一行最多寫這麼長，超過就自動折到左邊。
     * 水平方向不設限，讓〈長恨歌〉這種長詩能一路往左長，由外層橫向捲動。
     *
     * 下限是第 8 輪（第十二圈）加的：52vh 在橫放的手機上只有 195px，
     * 而一句七言要 199px，於是每一句都被折成兩截（量測與理由寫在
     * frontmatter 的 longestLine 旁邊）。下限從詩自己最長的一句算出來，
     * 不是猜一個數字 —— 換一首字數不同的詩會自己跟著變。
     * 0.5em 是留給字型度量與四捨五入的餘裕（七言實測只差 4px 就折了）。
     *
     * 外層仍然是 min(21rem, …)：21rem ÷ 最大字級 28px ≈ 12 個字，
     * 也就是**超過 12 字的句子在任何螢幕上都還是會折**。
     * 目前站上最長的一句是 7 字，碰不到；記在待辦裡。
     */
    max-inline-size: min(
      21rem,
      max(52vh, calc(var(--poem-longest-line, 7) * 1.14em + 0.5em))
    );

    /* 在 flex 容器裡用 auto margin 置中：內容短的時候置中，
       長到超出容器時兩邊都還捲得到（用 justify-content: center 會捲不到開頭） */
    margin: auto;
    flex: none;

    font-size: var(--t-lg);
    /*
     * 接回 token。`check:contrast` 的「未使用」那一段一直在說這件事：
     * 「--lh-loose（值 `2.1` 直接寫在 PoemBlock.astro 的 line-height）」，
     * 而它自己也寫了判準 ——「token 沒有當成唯一來源：改了 tokens.css，
     * 那邊不會跟著動」。第 8 輪（第五十四圈）照著做了。
     */
    line-height: var(--lh-loose);
    letter-spacing: 0.14em;

    /*
     * flex 的 column 方向跟著 block 軸走，所以這一行在兩種模式下都對：
     *   直排（vertical-rl）→ block 軸是水平由右往左，詩節一節一節往左排
     *   橫排（horizontal-tb）→ block 軸是垂直由上往下，詩節一節一節往下排
     * 用 row 的話直排時詩節會往下疊，整首詩就散掉了。
     */
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /*
   * ── 界欄：直排時每一行之間的那道細線 ────────────────
   *
   * 刻本的版框裡，每一行字之間都有一條細線，叫「界欄」（烏絲欄）。
   * 有了它，版框才不只是一個框，而是一葉真的書。
   *
   * 畫在 `.poem__stanza` 上而不是 `.poem__original` 上 ——
   * 詩節之間有 `gap: var(--s-6)` 的空隙，畫在外層的話那道 2rem
   * 會把後面每一節的線全部推歪（〈琵琶行〉有三節）。
   * 每一節各自從自己的右緣起算，就永遠對得上。
   *
   * 週期用 2.1em：直排時一行的推進距離就是 line-height（--lh-loose），
   * 而字距（letter-spacing）只影響行**內**，不影響行距。
   * 所以這個數字不是量出來的，是算出來的 —— 改 --lh-loose 它自己跟著走。
   */
  .poem__stanza {
    margin: 0;
    background-image: repeating-linear-gradient(
      to left,
      var(--c-rule) 0 1px,
      transparent 1px 2.1em
    );
  }

  /*
   * 橫排沒有界欄 —— 橫著寫的字之間畫線就成了稿紙，不是刻本。
   * 三個選擇器對應「這首詩現在是橫排」的三種到達方式（理由見下面那段）。
   */
  .poem[data-orientation="horizontal"] .poem__stanza,
  :root[data-poem-orientation="horizontal"] .poem:not([data-orientation]) .poem__stanza,
  :root:not([data-poem-orientation])
    .poem[data-default-orientation="horizontal"]:not([data-orientation])
    .poem__stanza {
    background-image: none;
  }

  /*
   * 橫排：直接把 writing-mode 換掉，其餘沿用。
   *
   * 三個選擇器對應「這首詩現在是橫排」的三種到達方式，缺一個就會跳版：
   *
   *   1. 下面那段 module 已經跑完，把 data-orientation 設好了
   *   2. module 還沒跑，但使用者存過「橫排」——
   *      <head> 的 inline script 已經把偏好寫在 :root 上（第 2 輪〔第十圈〕加的）
   *   3. module 還沒跑、也沒有存過偏好，而**這首詩本身的預設就是橫排**
   *      （`vertical: false`）。目前三首詩都是 true，所以這條打不到 ——
   *      但 schema 允許，而少了它的話那種詩每個訪客都會看到跳版，
   *      不只是存過偏好的人。順帶也讓關掉 JS 的人拿到對的方向。
   *
   * `:not([data-orientation])` 讓 2、3 只在 module 接手前生效。
   */
  .poem[data-orientation="horizontal"] .poem__original,
  :root[data-poem-orientation="horizontal"] .poem:not([data-orientation]) .poem__original,
  :root:not([data-poem-orientation])
    .poem[data-default-orientation="horizontal"]:not([data-orientation])
    .poem__original {
    writing-mode: horizontal-tb;
    text-orientation: mixed;
    max-inline-size: 100%;
    /*
     * 一句不能被折斷 —— 跟直排那條下限是同一件事，只是軸換了。
     *
     * 直排那邊寫的是 `max-inline-size` 的下限（`calc(N * 1.14em + 0.5em)`），
     * 用 em 寫，所以字級一放大它自己跟著長。橫排這一支原本只有
     * `max-inline-size: 100%` —— 那是**容器的百分比**，不跟著字級走。
     *
     * 2026-09-09 實測（放大瀏覽器的預設字級，WCAG 1.4.4 要求撐到 200%）：
     *
     *   視窗 320px　字級 150%　→ 不折
     *   視窗 320px　字級 175%　→ 四句七言**每一句都折成兩截**
     *   視窗 360px　字級 200%　→ 折（360 是最常見的 Android 寬度）
     *   視窗 375px　字級 200%　→ 不折（一句七言要 287px，這裡剛好夠）
     *   直排任何寬度　字級 200%　→ 不折（它的下限是 em 寫的）
     *
     * 折出來的樣子是「秦時明月漢／時關」—— 那不是排版難看，是**讀錯**。
     *
     * 所以這裡下的是 `min-inline-size`：整塊至少要有一句那麼長。
     * 真的不夠寬時它會超出容器，而 `.poem__scroll` 是 `overflow-x: auto`，
     * 於是變成橫向捲一小段，不是把句子切開。
     * （縮字級也能解，但那是在跟使用者「我要大字」的設定作對。）
     */
    min-inline-size: calc(var(--poem-longest-line, 7) * 1.14em + 0.5em);
    text-align: center;
    line-height: 2.2;
    letter-spacing: 0.1em;
  }

  .poem__source {
    text-align: center;
    font-size: var(--t-xs);
    margin-block-start: var(--s-2);
  }

  /* 窄螢幕一律橫排 —— 直排在手機上要側著頭看，不合理 */
  @media (max-width: 48rem) {
    .poem__original,
    .poem[data-orientation="vertical"] .poem__original {
      writing-mode: horizontal-tb !important;
      text-orientation: mixed;
      max-inline-size: 100%;
      /* 同上面那段註解 —— 窄螢幕一律橫排，所以這條才是手機上真正生效的那一份 */
      min-inline-size: calc(var(--poem-longest-line, 7) * 1.14em + 0.5em);
      text-align: center;
      font-size: var(--t-md);
    }

    /* 窄螢幕一律橫排，界欄跟著收起來 */
    .poem__stanza { background-image: none; }

    .poem__toggle { display: none; }
  }

  /*
   * 列印：超過 13 句的直排詩退回橫排。
   *
   * 理由與實測數字寫在最上面 frontmatter 的 PRINT_VERTICAL_MAX_LINES 旁邊。
   * 一句話：紙上沒有捲軸，直排長詩超出容器的部分會**無聲地印不出來**。
   *
   * 用 !important 是為了跟上面那條窄螢幕規則對齊 —— 兩條做的是同一件事
   * （在放不下直排的地方退回橫排），權重寫法不一致以後很容易改壞其中一條。
   *
   * overflow 改成 visible：紙上「可捲動」沒有意義，而 auto 會多一層裁切邊界。
   * 退回橫排之後理論上不會再溢出，這一行是萬一真的溢出時少裁掉一點。
   */
  @media print {
    .poem[data-print-overflows] .poem__original,
    .poem[data-print-overflows][data-orientation="vertical"] .poem__original {
      writing-mode: horizontal-tb !important;
      max-inline-size: 100% !important;
      text-align: center;
    }

    /*
     * 紙上把上面那個下限關掉。
     *
     * 螢幕上放不下就橫向捲，紙上沒有捲軸 —— 留著下限的話，超出頁面的那半句
     * 會**無聲地印不出來**（跟 PRINT_VERTICAL_MAX_LINES 擋的是同一種事故）。
     * 折行至少讀得到全部的字。兩個媒介只能挑一個壞法，紙上挑折行。
     */
    .poem__original,
    .poem[data-orientation="horizontal"] .poem__original,
    .poem[data-print-overflows] .poem__original {
      min-inline-size: 0 !important;
    }

    .poem__scroll {
      overflow: visible;
      /* 紙上不會捲，那道影會變成兩條永遠在的髒東西 */
      background-image: none;
    }
  }

  /* ── 注與白話 ────────────────────────────────────── */

  .poem__section {
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: var(--border-thin);
  }

  .poem__section-title {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    color: var(--c-ink-faint);
    text-transform: uppercase;
    margin-block-end: var(--s-4);
  }

  .poem__annotations {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }

  .poem__annotation {
    display: grid;
    grid-template-columns: minmax(5rem, 9.5rem) 1fr;
    gap: var(--s-4);
    align-items: baseline;
  }

  .poem__annotation dt {
    font-weight: 600;
    color: var(--c-flame-ink);
  }

  /*
   * 注的解釋是散文，不是標題 —— 用內文的行距。
   * 第 8 輪（第五十四圈）量到：13.2px 的字配 19.1px 的行框，
   * 兩行中文之間只剩 5.9px，而同一頁的白話有 15.4px。
   */
  .poem__annotation dd {
    margin: 0;
    color: var(--c-ink-soft);
    font-size: var(--t-sm);
    line-height: var(--lh-body);
  }

  .poem__plain {
    font-size: var(--t-md);
    line-height: var(--lh-body);
    color: var(--c-ink-soft);
    padding-inline-start: var(--s-4);
    border-inline-start: 2px solid var(--c-flame);
  }

  @media (max-width: 34rem) {
    .poem__annotation {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>

<script>
  const KEY = 'fox-poem-orientation';

  for (const poem of document.querySelectorAll<HTMLElement>('.poem')) {
    const fallback = poem.dataset.defaultOrientation ?? 'vertical';
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch { /* 無痕模式 */ }
    poem.dataset.orientation = saved === 'horizontal' || saved === 'vertical' ? saved : fallback;

    const button = poem.querySelector<HTMLButtonElement>('[data-poem-toggle]');

    /** 讓 aria-label 跟著實際狀態走 —— 文案在 build 時就放進 data 屬性了 */
    const syncLabel = () => {
      if (!button) return;
      const key = poem.dataset.orientation === 'vertical' ? 'labelVertical' : 'labelHorizontal';
      const label = button.dataset[key];
      if (label) button.setAttribute('aria-label', label);
    };

    // 進站時 orientation 可能被 localStorage 改掉，label 要跟著對齊
    syncLabel();

    button?.addEventListener('click', () => {
      poem.dataset.orientation = poem.dataset.orientation === 'vertical' ? 'horizontal' : 'vertical';
      syncLabel();
      try { localStorage.setItem(KEY, poem.dataset.orientation); } catch { /* 無痕模式 */ }
    });
  }
</script>
