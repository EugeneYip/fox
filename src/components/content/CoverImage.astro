---
/**
 * 文章的封面圖。
 *
 * 之前 content.config.ts 宣告了 `cover` 欄位、CONTENT.md 也教了怎麼填，
 * 但沒有任何頁面會渲染它 —— 填了等於沒填，而且沒有任何錯誤訊息。
 * 這個元件補上那一塊。
 *
 * 兩個刻意的決定：
 *
 * 1. 一定要輸出 width / height。瀏覽器在圖片載入前就能算出它會佔多高，
 *    才不會在載入的瞬間把下面的文字推開（CLS）。第 2 輪量到全站 CLS 是 0，
 *    加圖片是最容易把它弄壞的一步。Astro 的 <Image> 會從 ImageMetadata
 *    自動帶上尺寸，所以只要用它就好，不要退回原生 <img>。
 *
 * 2. **用 `widths` ＋ `sizes`，不用 `densities`。**
 *
 *    第 8 輪（第二十圈）第一次在瀏覽器裡看真的封面圖才發現的：
 *    `densities={[1,2]}` 產出的 srcset 是 `… 1x, … 2x`，**沒有 `sizes`**，
 *    所以瀏覽器只看裝置像素比，不看版面寬度。實測 320px 的視窗、DPR 2：
 *
 *      版面上那張圖  280px 寬
 *      瀏覽器選的檔  **1800px 寬那一個**（6.4 倍的像素）
 *
 *    也就是**最小的螢幕拿到最大的檔案**。第 2 輪（第二十圈）量到那個 2x
 *    檔在細節照片上是 267 KB —— 手機正好是最不該收到它的地方。
 *
 *    改成 `widths` ＋ `sizes` 之後，瀏覽器按版面寬度挑。
 *
 * 3. 沒有填 alt 就當作純裝飾（alt=""）。
 *    寧可讓螢幕閱讀器跳過，也不要唸出一段沒有意義的檔名。
 *    真的需要描述的圖，就在 frontmatter 補 coverAlt。
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** 詩詞頁的封面窄一點，文章頁滿版 */
  width?: number;
  /**
   * 這張圖所在的**欄寬上限**，要跟外層 `.wrap--*` 的 token 一致。
   * 詩詞頁是 `.wrap--content`（46rem），文章頁是 `.wrap--prose`（34rem）。
   * 見底下 `sizes` 那一段的說明 —— 這不是 `width`，兩個是不同的東西。
   */
  column?: string;
  caption?: string;
}

const { src, alt, width = 900, column = '46rem', caption } = Astro.props;

/*
 * ── `sizes` 描述的是**欄寬**，不是 `width`，也不是視窗 ──────────
 *
 * 第 8 輪（第三十九圈）在瀏覽器裡量出來的。原本寫的是
 * `(max-width: 40rem) 100vw, ${width}px` —— 三個部分都不對：
 *
 * 1. **`40rem` 不對應任何東西。** 版面上根本沒有這個斷點。
 * 2. **`100vw` 不對。** 圖是 `inline-size: 100%`，填的是 `.wrap` 扣掉
 *    左右 `--gutter` 之後的欄寬，永遠比視窗窄。實測 640px 視窗上是 576px。
 * 3. **`${width}px` 不對，而且錯得最遠。** `width` 是內在尺寸（給長寬比用的），
 *    跟版面上真的畫多寬沒有關係。兩個用處都對不上：
 *
 *      文章（EntryLayout，`.wrap--prose`）　width=900　真正上限 34rem＝544px
 *      詩詞頁（`.wrap--content`）　　　　　width=760　真正上限 46rem＝736px
 *
 * 真正的欄寬就是 `.wrap` 那兩行 CSS：
 *
 *      .wrap           { padding-inline: var(--gutter); }
 *      .wrap--content  { max-width: calc(var(--w-content) + var(--gutter) * 2); }
 *
 *   → 欄寬 ＝ min(100vw − 2 × gutter, 那個 --w-* token)
 *
 * `sizes` 裡**不能用 `var()`** —— 瀏覽器的預載掃描器在 CSS 變數解析之前
 * 就要讀這個屬性，所以 `--gutter` 的值只能照抄一份。抄的那一份會漂，
 * 所以兩邊都留了指回對方的註解（`tokens.css` 的 `--gutter` 也是）。
 *
 * 實測這個寫法瀏覽器吃得下，而且真的改變了選檔：
 * 420px 視窗、DPR 2 —— 原本挑 1200w，改完挑 800w。
 */
const GUTTER = 'clamp(1.25rem, 5vw, 3rem)';
const sizes = `min(100vw - 2 * ${GUTTER}, ${column})`;
const decorative = !alt?.trim();
---

<figure class="cover">
  <Image
    src={src}
    alt={alt ?? ''}
    width={width}
    widths={[400, 800, 1200, 1600]}
    sizes={sizes}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    role={decorative ? 'presentation' : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cover {
    margin: 0 0 var(--s-6);
  }

  .cover :global(img) {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--r-md);
    background: var(--c-bg-sunken);
  }

  .cover figcaption {
    margin-block-start: var(--s-2);
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    text-align: center;
  }
</style>
