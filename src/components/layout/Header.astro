---
import { site, nav, DEFAULT_LOCALE, type Locale } from '@config/site';
import { useTranslations, localizePath, pick } from '@i18n/utils';
import FoxMark from '@components/fox/FoxMark.astro';
import ThemeToggle from '@components/layout/ThemeToggle.astro';
import LanguageSwitcher from '@components/layout/LanguageSwitcher.astro';

interface Props { locale: Locale; availableLocales?: readonly Locale[] }
const { locale, availableLocales } = Astro.props;
const t = useTranslations(locale);

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const full = localizePath(href, locale);
  return here === full || here.startsWith(full + '/');
};

/*
 * 導覽刻意不做漢堡選單。項目只有五個，手機上讓它橫向捲動就好 ——
 * 少一層互動、少一段 JavaScript，也少一個無障礙上容易出錯的地方。
 */
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={localizePath('/', locale)}>
      <FoxMark size={30} />
      <span class="brand__text">
        <span class="brand__name">{pick(site.name, locale) ?? site.name[DEFAULT_LOCALE]}</span>
        <span class="brand__tagline faint">{pick(site.tagline, locale)}</span>
      </span>
    </a>

    <nav class="site-nav ui" aria-label={t('nav.menu')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={localizePath(item.href, locale)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {pick(item.label, locale)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <LanguageSwitcher locale={locale} available={availableLocales} />
      <ThemeToggle
        label={t('nav.theme')}
        states={{ system: t('theme.system'), light: t('theme.light'), dark: t('theme.dark') }}
        next={{
          template: t('theme.next'),
          system: t('theme.nameSystem'),
          light: t('theme.nameLight'),
          dark: t('theme.nameDark'),
        }}
        join={t('theme.join')}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-thin);
    /*
     * ── 這一行是 fallback，不要刪 ──────────────────
     *
     * `color-mix()` 不支援的話**整條宣告會被丟掉**（實測：
     * 用一個不合法的色彩空間去設，`style.background` 回空字串）。
     * 而這是 `position: sticky` 的頁首 —— 沒有背景就等於
     * 導覽列的字直接印在捲過去的內文上，兩邊都讀不了。
     * 第 1 輪（第二十二圈）截圖看過那個樣子。
     *
     * tokens.css 對每一個 `light-dark()` 都寫了一行單值 fallback，
     * 而 `color-mix()` 沒有 —— 同一套紀律只用在其中一個上。
     * （`check:contrast` 現在兩個都守。）
     */
    /*
     * ── 從半透明毛玻璃改成不透明 ──────────────────
     *
     * 本來是 `color-mix(… 88%, transparent)` ＋ `backdrop-filter: blur(10px)`。
     * 第 8 輪（第五十三圈）在瀏覽器裡捲一次首頁看到的：站名那行大字會從
     * 頁首底下**糊出來**，在一個以「紙」為材質的站上讀起來像沒對齊，不像效果。
     *
     * 而同一件事一直是量得出來的缺口：`check:contrast` 每一次都會警告
     * 「.site-header 上的 --c-ink-faint 最壞 4.09:1（淺）／4.11:1（深）」——
     * 低於 AA 的 4.5，而那個「最壞」正是底下捲過 --c-seal／--c-flame 的時候。
     * `docs/STATE.md` 也把它列在「還沒解決」裡。
     *
     * 改成不透明之後：糊掉的字沒有了，而那兩個最壞情況也不存在了
     * （頁首的字現在永遠是印在 --c-bg 上，4.94:1 與 4.86:1，兩套都過）。
     * 分隔仍然靠那條 `border-block-end` 的髮絲線 —— 這個站本來就不用陰影堆層次。
     */
    background: var(--c-bg);
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
  }

  /*
   * ── 螢幕不夠高的時候就不要黏了 ────────────────────
   *
   * 第 8 輪（第五十四圈）在瀏覽器裡量的（同一頁、只改視窗）：
   *
   *   1280×800   頁首 68px   佔  9%
   *   640×400    頁首 66px   佔 17%   ← 桌機放大到 200%
   *   427×267    頁首 107px  佔 40%   ← 桌機放大到 300%
   *   320×256    頁首 107px  佔 42%   ← WCAG 1.4.10 指定的那個尺寸
   *   390×844    頁首 107px  佔 13%   ← 一般手機，沒事
   *
   * 320×256 就是 1280×1024 放大到 400%，那條規準（Reflow）點名的尺寸。
   * 在那裡，一條**永遠蓋著 42% 畫面**的橫槓比它擋住的內容還大。
   * 而這件事看不見：`check:a11y` 掃的是 HTML，量不到算繪出來的高度。
   *
   * 用 `em` 不是 `rem`、也不是 `px`，是因為媒體查詢裡的 em 是對著
   * **瀏覽器的預設字級**算的（頁面自己設的 html { font-size } 不算數）。
   * 所以同一條規則接得住兩種「螢幕變矮」：
   *   放大整頁 → CSS 像素的視窗真的變矮 → 30em（480px）比得到
   *   只放大字 → 預設字級變大 → 30em 跟著變大，也比得到
   *
   * 30em 的理由：頁首排成兩行是 107px ≈ 6.7em，480px 的時候它佔 22%，
   * 再矮下去只會更糟。捲上去就看得到頁首，跟任何一份紙本一樣。
   */
  @media (max-height: 30em) {
    .site-header {
      position: static;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-block-size: 4rem;
    padding-block: var(--s-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__name {
    font-size: var(--t-md);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .brand__tagline {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
  }

  .site-nav {
    flex: 1;
    min-inline-size: 0;
  }

  /*
   * ── 導覽列用換行，不用橫向捲 ──────────────────────
   *
   * 本來是 `overflow-x: auto` ＋ `scrollbar-width: none`（捲軸還藏起來）。
   * 第 1 輪（第五十四圈）問「最壞的輸入下長什麼樣」，在瀏覽器裡量到：
   *
   *   視窗 320px、根字級 16px    五項都在（最右邊 247px）—— 那條捲軸從來用不到
   *   視窗 320px、根字級 32px    只看得到「詩詞 文章 短札」，
   *                              「各處」在 392px、「關於」在 492px —— **看不到，也沒有任何提示**
   *
   * 內容沒有真的消失（那一條可以滑、Tab 也走得進去），所以不算違反 1.4.4；
   * 但把捲軸藏起來等於**連「還有東西」都不說**。一個把預設字級調大的人
   * 看到的是一個只有三項的選單。
   *
   * 改成換行：預設字級下五項本來就排得下，所以**畫面一點都沒變**；
   * 字級一大就換到第二行，全部看得到。橫向的 gap 維持 --s-5，
   * 換行之後的行距用 --s-2（1.5rem 當行距太鬆）。
   */
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav li { margin: 0; }

  .site-nav a {
    display: block;
    white-space: nowrap;
    font-size: var(--t-sm);
    text-decoration: none;
    padding-block: var(--s-2);
    color: var(--c-ink-soft);
    position: relative;
  }

  .site-nav a:hover { color: var(--c-ink); }

  /* 目前所在的頁面：底下一道狐火色的短線 */
  .site-nav a[aria-current="page"] {
    color: var(--c-ink);
  }

  .site-nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 2px;
    background: var(--c-flame);
    border-radius: 1px;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  @media (max-width: 52rem) {
    .brand__tagline { display: none; }
    .site-header__inner { gap: var(--s-4); }
  }

  @media (max-width: 34rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: var(--s-2);
    }
    /*
     * 窄螢幕時導覽換到第二列。
     *
     * ## 這會讓 Tab 順序跟畫面順序對不起來
     *
     * 第 1 輪（第五圈）實測 375px：
     *
     *   DOM 順序    brand → nav（5 個連結）→ tools（語言、主題）
     *   畫面順序    brand、tools（第一列）→ nav（第二列）
     *
     * 所以鍵盤使用者會：brand →（跳到第二列）nav →（跳回第一列）語言、主題。
     * 45 個可聚焦元素裡有 7 個的順序不一致，全部在 header。
     *
     * ## 為什麼沒有改
     *
     * **這不是 WCAG 2.4.3 的違規** —— 那一條要求的是「順序保留意義與可操作性」，
     * 而「主要導覽在次要控制項之前」本來就是有意義的順序。
     *
     * 而且沒有免費的修法：DOM 只有一種順序，桌面版與手機版的視覺順序不同，
     * 讓其中一邊對齊就會讓另一邊對不齊。要真的解決得改設計
     * （例如手機版把 tools 也放到第二列、接在 nav 後面），那是站主的決定。
     *
     * 量測的方式記在 REVIEW-LOG.md 第 1 輪（第五圈）：
     * 用真的 .focus() 測可聚焦性，再比對 DOM 順序與視覺座標。
     * **要在多個視窗寬度各量一次** —— 第四圈只量了桌面，所以沒看到這件事。
     */
    .site-nav {
      order: 3;
      flex-basis: 100%;
      margin-inline: calc(var(--gutter) * -1);
      /*
       * 留白放在**捲動內容**（ul）上，不放在捲動容器（nav）上。
       *
       * 第 8 輪（第十八圈）在真的瀏覽器裡量到：padding 放在 .site-nav 上時，
       * 320px 的英文導覽會超出 13px（五個英文項目比中文寬），
       * 而**捲到底時最後一項「About」的右緣落在 320.2px** —— 貼著螢幕邊緣，
       * 左邊卻有 20px。原因是捲動容器的尾端 padding 不算進 scrollWidth，
       * 那一邊的 20px 等於不存在。
       *
       * 改放在 ul 上之後，那段留白是捲動內容的一部分，捲到底仍然留得住。
       * 中文在 320px 下原本就有 73px 餘裕，這個改動對它沒有影響。
       */
      padding-inline: 0;
    }

    /*
     * 上面那一段（尾端 padding 留不住）**是捲動容器才有的問題**。
     * 第 1 輪（第五十四圈）把導覽列從橫向捲改成換行之後就不存在了 ——
     * 沒有捲動，就沒有「捲到底」。
     *
     * `inline-size: max-content` 因此也拿掉了：它會讓 ul 跟著內容長到
     * 532px（根字級 32px 時實測），而現在沒有捲動容器接住它，
     * **整頁會橫向溢出 212px** —— 比原本更糟。
     * 留 `min-inline-size: 100%`：那一行本來就只是「內容不夠寬時維持原樣」。
     */
    .site-nav ul {
      padding-inline: var(--gutter);
      min-inline-size: 100%;
    }
    .site-header__tools { margin-inline-start: auto; }
  }
</style>
