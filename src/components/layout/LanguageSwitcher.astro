---
/**
 * 語言切換。
 *
 * 用原生 <details> 做下拉，不需要 JavaScript 也能用；
 * 唯一的 JS 是「點外面關起來」這個便利功能，沒有它也不影響操作。
 */
import { LOCALES, LOCALE_LABEL, type Locale } from '@config/site';
import { switchLocalePath, useTranslations, localizePath } from '@i18n/utils';

/*
 * `available` = 這一頁**真的存在**的語言。預設是全部 —— 對 `[...locale]`
 * 那些兩種語言都會產生的頁面來說那是對的。
 *
 * 內容衍生的頁面（詩／文章／短札的內頁、標籤頁）只有一種語言，
 * 由那些頁面自己傳進來。第 7 輪（第十一圈）量到：全站有 **19 個頁面**
 * 的語言鈕指向不存在的網址，點下去會落到**中文的 404 頁**上 ——
 * 對一個剛按下「English」的人來說是雙重的糟糕。
 *
 * 沒有對應頁面時連到該語言的首頁：那一頁一定存在，而且語意上也對 ——
 * 「這一頁沒有英文版，這是英文版的站」。
 */
interface Props { locale: Locale; available?: readonly Locale[] }
const { locale, available = LOCALES } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;

const SHORT: Record<Locale, string> = { 'zh-TW': '中', en: 'EN' };
const localeHome = (l: Locale) => localizePath('/', l);
---

<details class="lang">
  <summary class="lang__button ui" aria-label={t('nav.language')} title={t('nav.language')}>
    <span>{SHORT[locale]}</span>
  </summary>
  <ul class="lang__menu ui">
    {LOCALES.map((l) => (
      <li>
        <a
          href={available.includes(l) ? switchLocalePath(pathname, l) : localeHome(l)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
        >
          {LOCALE_LABEL[l]}
          {/*
            沒有對應頁面時這個連結去的是該語言的**首頁**，而它的名字仍然只有
            「English」—— 名字說的是「換語言」，做的是「換語言，並且離開這一頁」。
            第 1 輪（第五十二圈）量到：32 個中文頁裡 19 頁是這種情況，
            而同一頁 `<head>` 的 hreflang **沒有**宣告英文版 ——
            給機器看的那一份說了實話，給人看的那一份沒有。
            補的方式是 `ExternalLink.astro` 那個形狀：sr-only 進可及名稱，畫面上的字不動。
            （那個元件本身**沒有任何人 import**，是第三十圈量出來的 —— 見 `docs/TODO.md`。
            所以這裡不是「照著現成的做法」，是那個形狀第一次真的出現在產出裡：
            實測 `dist/` 裡 `<a>` 內含 sr-only 的連結，在這一行之前是 0 個。）
            文字前面那個空格寫在字串裡不是靠排版：可及名稱是把子節點接起來算的，
            接的時候不會自己補空白，於是會變成「English(no version…」。
            span 自己標 `lang={locale}`：這句話是用**這一頁的語言**寫的，
            而它住在一個 `lang={l}` 的連結裡，不標的話英文頁上會用英文語音唸中文。
            只補「別的語言」那一個 —— 目前語言的那一個帶著 aria-current，
            說「這一頁沒有中文版」在中文頁上是錯的。
          */}
          {l !== locale && !available.includes(l) && (
            <span class="sr-only" lang={locale}>{' ' + t('nav.languageNoPage')}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang { position: relative; }

  .lang__button {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: var(--r-md);
    color: var(--c-ink-soft);
    font-size: var(--t-sm);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  .lang__button::-webkit-details-marker { display: none; }

  .lang__button:hover,
  .lang[open] .lang__button {
    color: var(--c-flame-ink);
    background: var(--c-bg-sunken);
  }

  .lang__menu {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + var(--s-2));
    min-inline-size: 9rem;
    margin: 0;
    padding: var(--s-1);
    list-style: none;
    background: var(--c-bg-raised);
    border: 1px solid var(--c-rule-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lift);
    z-index: 30;
  }

  .lang__menu li { margin: 0; }

  .lang__menu a {
    display: block;
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-sm);
    text-decoration: none;
    border-radius: var(--r-sm);
    white-space: nowrap;
  }

  .lang__menu a:hover { background: var(--c-bg-sunken); }

  /*
   * ── 這一條的選擇器不寫死那個值 ──────────────────
   *
   * `aria-current` 在這個站身兼兩職：**無障礙的狀態**，以及**樣式的鉤子**
   * （Header、Footer、Pagination 也都是這樣，各自寫著 `[aria-current="page"]`）。
   * 沒有一處註解講過這件事。
   *
   * 而這一個特別容易被「順手改對」：這裡的值是 `true` 不是 `page`，
   * 看起來像漏改 —— 其實是刻意的。它標的是**目前的語言**，不是目前的頁。
   * 404 頁就是證據：那一頁的「繁體中文」指向 `/`，**根本不是當前頁**，
   * 寫 `page` 會是假話。
   *
   * 第 1 輪（第五十三圈）實測把它改成 `'page'`：建置過、產出裡
   * `aria-current="true"` 從 44 個變成 **0 個**、這一條規則一個元素都配不到
   * （目前語言的橘色與粗體整站消失），而 `check:a11y`／`check:contrast`／
   * `check:content`／`check:copy`／`audit:privacy`／`check:perf`／`check:links`
   * **七道全部離開碼 0**。
   *
   * 改成只看屬性在不在：這個元件只有「目前語言」那一個會帶 `aria-current`
   * （其餘是 `undefined`），所以今天的畫面一模一樣，而值換了樣式不會掉。
   */
  .lang__menu a[aria-current] {
    color: var(--c-flame-ink);
    font-weight: 600;
  }
</style>

<script>
  // 點到別的地方就把下拉關起來。沒有這段也能用（再點一次按鈕即可）。
  document.addEventListener('click', (event) => {
    for (const details of document.querySelectorAll<HTMLDetailsElement>('details.lang[open]')) {
      if (!details.contains(event.target as Node)) details.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const details of document.querySelectorAll<HTMLDetailsElement>('details.lang[open]')) {
      details.open = false;
      details.querySelector<HTMLElement>('summary')?.focus();
    }
  });
</script>
