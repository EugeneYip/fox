---
import { site, footerNav, DEFAULT_LOCALE, type Locale } from '@config/site';
import { useTranslations, localizePath, pick } from '@i18n/utils';
import { year } from '@lib/dates';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * 版權年份也用臺北時間 —— 這是一個臺灣的站。
 * `getFullYear()` 讀的是建置機器的時區（站主的機器在美東，CI 在 UTC），
 * 所以跨年那幾個小時三台機器會給三個答案。見 lib/dates.ts 的說明。
 */
/*
 * 頁尾的「你在這裡」。
 *
 * 第 1 輪（第三十圈）量到：導覽列標了 aria-current，頁尾沒有 ——
 * 同一個站的兩個 nav，一個說得出「你正在這一頁」，另一個不說。
 * 全站 20 個「nav 裡連到自己」的連結，**10 個沒有標記，全部在頁尾**。
 * 螢幕閱讀器使用者在 /archive 上逐一聽頁尾，聽到的是「封存，連結」，
 * 跟其他四個一模一樣。
 *
 * 這裡用**完全相符**，不像 Header 那樣往下比對前綴 ——
 * 頁尾放的是單頁的工具連結（彙整、標籤、搜尋、隱私），
 * 在 /tags/唐詩 上把 /tags 標成 `page` 是錯的：那不是同一頁。
 * 兩個 nav 的語意本來就不同，硬要共用一個判斷反而會錯一邊。
 */
const here = Astro.url.pathname.replace(/\/$/, '') || '/';

const thisYear = year(new Date());
const years = thisYear > site.since ? `${site.since}–${thisYear}` : String(site.since);
const penName = pick(site.penName, locale) ?? site.penName[DEFAULT_LOCALE];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__body ui">
      <nav aria-label={t('footer.builtWith')}>
        <ul>
          {footerNav.map((item) => {
            const href = item.href.startsWith('/rss') ? item.href : localizePath(item.href, locale);
            return (
              <li>
                <a href={href} aria-current={href.replace(/\/$/, '') === here ? 'page' : undefined}>
                  {pick(item.label, locale)}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <p class="site-footer__legal faint">
        <span>© {years} {penName}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  /*
   * ── 頁尾：拿掉「狐」印，改成版心的魚尾 ──────────────
   *
   * 站主 2026-09-11 說最下方不需要用「狐」代表。原本那裡是一方
   * 40px 的朱文印章，等於在每一頁的底部再擺一次 logo。
   *
   * 換成線裝書的版心標記：一條界線從中間垂下來，末端是一個魚尾。
   * 書葉對摺之後，版心就在紙的最外緣 —— 一頁的盡頭本來就長這樣。
   * 它不是誰的代表，它是「這一葉到這裡為止」。
   *
   * 用 ::before／::after 畫，不加任何元素，也不加標記 ——
   * 純裝飾的東西不該進到無障礙樹裡。
   */
  .site-footer {
    position: relative;
    border-block-start: var(--border-thin);
    padding-block: var(--s-7) var(--s-7);
    margin-block-start: auto;
  }

  /* 從那條分隔線垂下來的一小段界線 */
  .site-footer::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 1px;
    block-size: var(--s-5);
    background: var(--c-rule-strong);
  }

  /* 界線末端的魚尾 */
  .site-footer::after {
    content: "";
    position: absolute;
    inset-block-start: var(--s-5);
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 0.6rem;
    block-size: 0.85rem;
    background: var(--c-flame);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 58%, 0 100%);
  }

  /*
   * 印章拿掉之後，頁尾剩下兩行字靠在左邊，而版心的魚尾在正中間 ——
   * 兩個重心。改成整個置中：魚尾、連結、版權一條軸線下來，
   * 讀起來是「一卷到此為止」，不是「左下角還有東西」。
   */
  .site-footer__inner {
    display: flex;
    justify-content: center;
  }

  .site-footer__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
  }

  .site-footer nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer nav li { margin: 0; }

  .site-footer nav a {
    font-size: var(--t-sm);
    text-decoration: none;
    color: var(--c-ink-soft);
  }

  .site-footer nav a:hover {
    color: var(--c-flame-ink);
  }

  /*
   * 「你在這裡」看得見的那一半。
   *
   * 第 1 輪（第三十圈）補了 `aria-current` —— 螢幕閱讀器從此聽得出來，
   * 但**畫面上五頁完全沒有差別**（頁尾的連結全是 `--c-ink-soft`）。
   * 第 8 輪（第四十五圈）量到：`/about`、`/notes`、`/writing`、`/poems`、
   * 那五頁的頁尾都印著 `aria-current="page"`，
   * 而全站只有 `.site-nav`、`.pager__numbers`、`.lang__menu` 三組有樣式。
   *
   * 不照抄導覽列那道 2px 的短線：頁尾是 `--t-sm` 的工具連結，
   * 一道跟主導覽同粗的線會把它讀成第二個主導覽。
   * 用**顏色 ＋ 底線**兩個線索（只有顏色的話，WCAG 1.4.1 那條就只剩一半），
   * 底線借導覽列同一個狐火色，所以是同一套語彙的輕量版。
   */
  .site-footer nav a[aria-current="page"] {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-flame);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .site-footer__legal {
    font-size: var(--t-xs);
  }

</style>
