---
import { site, footerNav, DEFAULT_LOCALE, type Locale } from '@config/site';
import { useTranslations, localizePath, pick } from '@i18n/utils';
import FoxSeal from '@components/fox/FoxSeal.astro';
import { year } from '@lib/dates';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * 版權年份也用臺北時間 —— 這是一個臺灣的站。
 * `getFullYear()` 讀的是建置機器的時區（站主的機器在美東，CI 在 UTC），
 * 所以跨年那幾個小時三台機器會給三個答案。見 lib/dates.ts 的說明。
 */
/*
 * 頁尾的「你在這裡」。
 *
 * 第 1 輪（第三十圈）量到：導覽列標了 aria-current，頁尾沒有 ——
 * 同一個站的兩個 nav，一個說得出「你正在這一頁」，另一個不說。
 * 全站 20 個「nav 裡連到自己」的連結，**10 個沒有標記，全部在頁尾**。
 * 螢幕閱讀器使用者在 /archive 上逐一聽頁尾，聽到的是「封存，連結」，
 * 跟其他四個一模一樣。
 *
 * 這裡用**完全相符**，不像 Header 那樣往下比對前綴 ——
 * 頁尾放的是單頁的工具連結（封存、標籤、搜尋、隱私、colophon），
 * 在 /tags/唐詩 上把 /tags 標成 `page` 是錯的：那不是同一頁。
 * 兩個 nav 的語意本來就不同，硬要共用一個判斷反而會錯一邊。
 */
const here = Astro.url.pathname.replace(/\/$/, '') || '/';

const thisYear = year(new Date());
const years = thisYear > site.since ? `${site.since}–${thisYear}` : String(site.since);
const penName = pick(site.penName, locale) ?? site.penName[DEFAULT_LOCALE];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__mark">
      <FoxSeal char="狐" size={40} />
    </div>

    <div class="site-footer__body ui">
      <nav aria-label={t('footer.builtWith')}>
        <ul>
          {footerNav.map((item) => {
            const href = item.href.startsWith('/rss') ? item.href : localizePath(item.href, locale);
            return (
              <li>
                <a href={href} aria-current={href.replace(/\/$/, '') === here ? 'page' : undefined}>
                  {pick(item.label, locale)}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <p class="site-footer__legal faint">
        <span>© {years} {penName}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-thin);
    padding-block: var(--s-6) var(--s-7);
    margin-block-start: auto;
  }

  .site-footer__inner {
    display: flex;
    gap: var(--s-5);
    align-items: flex-start;
  }

  .site-footer__mark { flex: none; }

  .site-footer__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .site-footer nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer nav li { margin: 0; }

  .site-footer nav a {
    font-size: var(--t-sm);
    text-decoration: none;
    color: var(--c-ink-soft);
  }

  .site-footer nav a:hover {
    color: var(--c-flame-ink);
  }

  /*
   * 「你在這裡」看得見的那一半。
   *
   * 第 1 輪（第三十圈）補了 `aria-current` —— 螢幕閱讀器從此聽得出來，
   * 但**畫面上五頁完全沒有差別**（頁尾的連結全是 `--c-ink-soft`）。
   * 第 8 輪（第四十五圈）量到：`/about`、`/notes`、`/writing`、`/poems`、
   * `/colophon` 五頁的頁尾都印著 `aria-current="page"`，
   * 而全站只有 `.site-nav`、`.pager__numbers`、`.lang__menu` 三組有樣式。
   *
   * 不照抄導覽列那道 2px 的短線：頁尾是 `--t-sm` 的工具連結，
   * 一道跟主導覽同粗的線會把它讀成第二個主導覽。
   * 用**顏色 ＋ 底線**兩個線索（只有顏色的話，WCAG 1.4.1 那條就只剩一半），
   * 底線借導覽列同一個狐火色，所以是同一套語彙的輕量版。
   */
  .site-footer nav a[aria-current="page"] {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-flame);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .site-footer__legal {
    font-size: var(--t-xs);
  }

  @media (max-width: 34rem) {
    .site-footer__inner { flex-direction: column; }
  }
</style>
