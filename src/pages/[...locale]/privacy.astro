---
/**
 * 隱私說明。
 *
 * 內容以「每個語言一份結構化資料」的方式定義，而不是直接把中文寫進樣板。
 * 原本是後者，結果 /en/privacy 整頁都是中文 —— 而這正好是英文訪客
 * 最需要讀得懂的一頁（這是網站對讀者的承諾）。
 *
 * 有些句子會隨 privacy.ts 的開關而不同（例如影片嵌入），所以內容是用
 * 函式產生的，不是靜態常數。
 */
import Base from '@layouts/Base.astro';
import PageHeader from '@components/layout/PageHeader.astro';
import { localePaths } from '@i18n/paths';
import { privacy, externalLinkRel } from '@config/privacy';
import { pick } from '@i18n/utils';
import { site } from '@config/site';
import type { Locale } from '@config/site';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };

/*
 * ── 那個網域也是抄的 ──────────
 *
 * 底下影片那一段對訪客說「YouTube 會知道你是從 bellafoxy.com 來的」。
 * 網域寫死了兩次（中英各一），而 `site.url` 就在 `@config/site` 裡 ——
 * 這一頁本來就 import 了它的**型別**，只是沒 import 值。
 *
 * 第 6 輪（第三十四圈）：跟上一輪那句 rel 的承諾是同一個形狀 ——
 * 答案在系統裡，而對訪客說的那一句自己抄了一份。
 * 換網域的時候，最不該說錯的就是這一頁。
 */
const host = new URL(site.url).host;
const title = pick({ 'zh-TW': '隱私', en: 'Privacy' }, locale) ?? '隱私';

interface Section {
  heading: string;
  /** 段落。`code` 標記的字串會被包成 <code> */
  paragraphs?: string[];
  items?: string[];
  /**
   * 摺起來的那一段：**機制與代號**，不是承諾。
   *
   * 站主 2026-09-11 要這一頁「有創意及文學氣息」，同一天也說
   * 「關於本站」對一般讀者資訊太多。這兩件事指向同一個做法：
   * **話留在外面，零件收進去。**
   *
   * 規則很硬：`summary` 只寫「要不要展開」，不承載任何承諾；
   * 而任何**對讀者不利**的事實（伺服器紀錄、影片框的例外）
   * 一律留在外面。摺起來的只有「它叫什麼」「它怎麼運作」。
   */
  detail?: { summary: string; paragraphs?: string[]; items?: string[] };
  /** 這一節末尾掛一條站外連結（現在只有「不相信的話」那一節用） */
  link?: { href: string; label: string };
}

const embedSentence = {
  'zh-TW': privacy.allowThirdPartyEmbeds
    ? '本站的影片以 iframe 直接嵌入，載入頁面時會向 YouTube 發出請求。'
    : '本站不直接嵌入 YouTube 影片。你按下播放之後才會載入，並且使用 youtube-nocookie.com。在那之前，Google 不會知道你來過。',
  en: privacy.allowThirdPartyEmbeds
    ? 'Videos on this site are embedded directly, so loading a page makes a request to YouTube.'
    : 'This site does not embed YouTube videos directly. One loads only after you press play, and it uses youtube-nocookie.com. Until then, Google does not know you were here.',
} as const;

/*
 * 「唯一的例外是⋯⋯」這一句原本是寫死的，而上面那句是跟著開關走的。
 * 第 5 輪（第十一圈）把開關翻成 `true` 建了一次，隱私頁就同時說了兩句
 * 互相矛盾的話：「載入頁面時會向 YouTube 發出請求」與「唯一的例外是
 * **你按下播放之後**的影片框」。同一頁上，一句說進站就送，一句說按了才送。
 *
 * 兩句都描述同一件事，就要跟著同一個開關。
 */
const exceptionSentence = {
  'zh-TW': privacy.allowThirdPartyEmbeds
    ? '唯一的例外是 YouTube 的影片框 —— 它在頁面載入時就會出現，用的是 youtube-nocookie.com。'
    : '唯一的例外是你按下播放之後的 YouTube 影片框 —— 那是你主動要求的，而且用的是 youtube-nocookie.com。',
  en: privacy.allowThirdPartyEmbeds
    ? 'The one exception is the YouTube frame, which loads with the page and uses youtube-nocookie.com.'
    : 'The one exception is the YouTube frame that appears after you press play — you asked for that one, and it uses youtube-nocookie.com.',
} as const;

/*
 * ── 這一頁的形狀：牌記 ＋ 摺起來的零件 ──────────────────
 *
 * 站主 2026-09-11 要這一頁「排版、互動、內容、文字」都更有文學氣息。
 *
 * 借的是**牌記** —— 線裝書末尾（或卷首）那一方框，印著誰刻的、
 * 什麼時候刻的，以及「翻刻必究」那一類的宣告。
 * 一份隱私聲明正是現代的牌記：這本書對讀者的宣告。
 * 所以開頭那三行放進一方版框裡，用站上既有的框線語彙，不另發明。
 *
 * 三行的寫法有一條界線：**不可以為了好聽而多說一點**。
 * 最後一行「它沒有辦法認得你，不是選擇不認」是整頁的骨架 ——
 * 那正是 CSP 那一節在講的事，也是這個站跟一句空承諾的差別。
 */
const REPO = 'https://github.com/EugeneYip/fox';

const CONTENT: Record<Locale, { mark: string[]; lead: string; sections: Section[] }> = {
  'zh-TW': {
    mark: [
      '這個網站不認得你。',
      '沒有帳號、沒有 cookie、沒有分析工具 ——',
      '它沒有辦法認得你，不是選擇不認。',
    ],
    lead: '這個網站不收集你的任何資料。',
    sections: [
      {
        heading: '沒有的東西',
        items: [
          'cookie',
          'Google Analytics，以及任何其他分析服務',
          '外部字型、外部 CDN、外部圖片',
          '會自己載入的第三方內容',
          '帳號 —— 所以也沒有個人資料可以存',
        ],
      },
      {
        heading: '留在你自己機器上的兩樣東西',
        paragraphs: [
          '這個站記得兩件事：你選的深淺，以及詩要直著讀還是橫著讀。兩個都存在你自己的瀏覽器裡，不會被送到任何地方 —— 換一臺機器，它就不認得了。',
        ],
        detail: {
          summary: '它們叫什麼',
          items: ['fox-theme —— 你選的深色或淺色', 'fox-poem-orientation —— 你選的詩詞直排或橫排'],
        },
      },
      {
        heading: '為什麼不必只靠相信',
        paragraphs: [
          '「不做」只是一句話。所以這個網站另外交給你的瀏覽器一道規則，由它替你擋：萬一哪天有人不小心放進一段外部腳本，你的瀏覽器會直接拒絕它，而不是安靜地送出請求。',
          exceptionSentence['zh-TW'],
        ],
        detail: {
          summary: '那道規則是什麼',
          paragraphs: [
            '是 Content Security Policy。這個網站在每一頁上宣告「只載入自己網域的東西」，而執行的是你的瀏覽器，不是網站自己 —— 那正是它跟一句承諾不一樣的地方。',
          ],
        },
      },
      {
        heading: '影片',
        paragraphs: [
          embedSentence['zh-TW'],
          /*
           * 第 5 輪（第十八圈）量到的落差：下面「對外連結」那一段說的是
           * 一律 noreferrer（對方什麼都拿不到），而影片框走的是 iframe，
           * referrerPolicy 是 strict-origin-when-cross-origin ——
           * YouTube 會知道你從這個網域來。兩件事不一樣，就分開講。
           */
          `按下播放之後，就進入 YouTube 自己的隱私政策範圍了。那個影片框會讓 YouTube 知道你是從 ${host} 來的（只有網域，不含是哪一頁）—— 下面「對外連結」那一條講的是連結，不含這個。`,
        ],
      },
      {
        heading: '對外連結',
        /*
         * ── 這一句原本是寫死的，而它其實有開關 ──────────
         *
         * `externalLinkRel` 是 `privacy.strictReferrerPolicy ? 'noopener noreferrer' : 'noopener'`。
         * 也就是說那個開關一關，站上每一個外部連結就沒有 noreferrer 了 ——
         * **而這一頁還是會說「一律加上 rel="noreferrer"」**。
         *
         * 這一頁是網站對讀者的承諾，而承諾寫成了不看開關的常數。
         * 第 5 輪（第三十四圈）：這一圈問「這個答案系統裡已經有了嗎」——
         * 有，`privacy` 這個檔案開頭就 import 進來了，而且上面影片那一段
         * 早就在用它了。只有這一句沒有。
         */
        paragraphs: [
          privacy.strictReferrerPolicy
            ? '站上的外部連結一律加上 rel="noreferrer"，對方網站不會知道你是從這裡點過去的。'
            : '站上的外部連結加上 rel="noopener"，沒有 noreferrer —— 對方網站會知道你是從這個站點過去的。',
        ],
      },
      {
        heading: '有一段不在我們手上',
        paragraphs: [
          `網站放在 GitHub Pages 上。GitHub 會保有伺服器層級的存取紀錄（IP 位址那一類），依它自己的隱私政策處理。我們既看不到，也關不掉 —— 上面那些「沒有」是這個站做得到的部分，這一段不是。`,
        ],
      },
      {
        heading: '不相信的話',
        paragraphs: [
          '這一頁說的每一件事都寫在原始碼裡，包括那幾個開關。整份是公開的 —— 你不必相信我們，可以自己去看。',
        ],
        link: { href: REPO, label: '原始碼' },
      },
    ],
  },
  en: {
    mark: [
      'This site does not know who you are.',
      'No accounts, no cookies, no analytics —',
      'it has no way to know you, which is not the same as choosing not to.',
    ],
    lead: 'This site collects nothing about you.',
    sections: [
      {
        heading: 'What is not here',
        items: [
          'Cookies',
          'Google Analytics, or any other analytics service',
          'External fonts, CDNs, remote images',
          'Third-party content that loads on its own',
          'Accounts — so there is no personal data to store',
        ],
      },
      {
        heading: 'Two things that stay on your own machine',
        paragraphs: [
          'This site remembers two things: whether you chose light or dark, and whether you read poems in columns or across. Both live in your own browser and are sent nowhere — open the site on another machine and it will not know you.',
        ],
        detail: {
          summary: 'What they are called',
          items: [
            'fox-theme — whether you chose light or dark',
            'fox-poem-orientation — whether you chose vertical or horizontal for poems',
          ],
        },
      },
      {
        heading: 'Why you do not have to take our word for it',
        paragraphs: [
          'Saying "we do not" is only a sentence. So the site also hands your browser a rule and lets it do the refusing: if someone ever slips in an outside script by mistake, your browser rejects it outright instead of quietly making the request.',
          exceptionSentence.en,
        ],
        detail: {
          summary: 'What that rule is',
          paragraphs: [
            'A Content Security Policy. Every page declares that it will only load things from its own domain, and it is your browser that enforces it, not the site — which is exactly what makes it different from a promise.',
          ],
        },
      },
      {
        heading: 'Video',
        paragraphs: [
          embedSentence.en,
          `Once you press play, YouTube's own privacy policy takes over. That frame does tell YouTube you came from ${host} — the domain only, not which page. The rule under "Outbound links" below is about links, not about this.`,
        ],
      },
      {
        heading: 'Outbound links',
        paragraphs: [
          privacy.strictReferrerPolicy
            ? 'Every external link carries rel="noreferrer", so the site you land on is not told where you came from.'
            : 'External links carry rel="noopener" but not noreferrer, so the site you land on is told that you came from here.',
        ],
      },
      {
        heading: 'One part is not ours to hold',
        paragraphs: [
          'The site is hosted on GitHub Pages. GitHub keeps server-level access logs (IP addresses and the like) under its own privacy policy. We can neither see them nor turn them off — everything above is what this site can do; this part is not.',
        ],
      },
      {
        heading: 'If you would rather check than trust',
        paragraphs: [
          'Everything on this page is written down in the source, including the switches. All of it is public — you do not have to take our word for it.',
        ],
        link: { href: REPO, label: 'the source' },
      },
    ],
  },
};

const { mark, lead, sections } = CONTENT[locale];

/** 把 key 名與屬性名包成 <code>，其餘照原樣輸出 */
/* `rel="noopener"` 也要進來 —— 開關關掉時那一段講的是它（見上面「對外連結」） */
const CODEY = /(fox-theme|fox-poem-orientation|rel="noreferrer"|rel="noopener"|youtube-nocookie\.com)/g;
const withCode = (text: string) => text.replace(CODEY, '<code>$1</code>');
---

<Base locale={locale} title={title} description={lead} class="wrap--prose">
  <PageHeader title={title} />

  {/* 牌記 —— 為什麼是這個形狀，見上面 CONTENT 前面那一段 */}
  <div class="mark">
    <p class="mark__inner">
      {mark.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </p>
  </div>

  <div class="prose">
    {sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.paragraphs?.map((p) => <p set:html={withCode(p)} />)}
        {section.items && (
          <ul>
            {section.items.map((item) => <li set:html={withCode(item)} />)}
          </ul>
        )}
        {section.detail && (
          <details>
            <summary>{section.detail.summary}</summary>
            {section.detail.paragraphs?.map((p) => <p set:html={withCode(p)} />)}
            {section.detail.items && (
              <ul>
                {section.detail.items.map((item) => <li set:html={withCode(item)} />)}
              </ul>
            )}
          </details>
        )}
        {section.link && (
          <p>
            <a href={section.link.href} target="_blank" rel={externalLinkRel}>{section.link.label}</a>
          </p>
        )}
      </>
    ))}
  </div>
</Base>
