---
import { render, type CollectionEntry } from 'astro:content';
import EntryLayout from '@layouts/EntryLayout.astro';
import { entryPaths } from '@i18n/paths';
import { getEntries, getNeighbors, estimateReadingTime, getTranslations } from '@lib/content';
import { externalLinkRel } from '@config/privacy';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@config/site';

export async function getStaticPaths() {
  return entryPaths(await getEntries('notes'));
}

const { entry, locale } = Astro.props as { entry: CollectionEntry<'notes'>; locale: Locale };
const { Content } = await render(entry);
const neighbors = await getNeighbors('notes', entry);
/*
 * 這一篇真的有哪幾種語言。`getTranslations()`（靠 `translationKey` 串同一篇的
 * 不同語言版本）從第一圈就寫好了，但**從來沒有人用過** —— 第 7 輪（第十一圈）
 * 量到語言鈕與 hreflang 都指向不存在的網址，才把它接上。
 */
const availableLocales = [locale, ...(await getTranslations('notes', entry)).map((tr) => tr.lang)];

const t = useTranslations(locale);
const source = entry.data.inResponseTo;
---

<EntryLayout
  locale={locale}
  availableLocales={availableLocales}
  title={entry.data.title}
  description={entry.data.description}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  readingMinutes={estimateReadingTime(entry, entry.body)}
  neighbors={neighbors}
  basePath="/notes"
>
  {source && (
    <p class="note-source ui">
      {/* 箭頭是裝飾 —— 說明關係的是後面那兩個字，不是它 */}
      <span aria-hidden="true">↳</span> {t('note.inResponseTo')}{' '}
      <a href={source.url} target="_blank" rel={externalLinkRel}>{source.title}</a>
    </p>
  )}
  <Content />
</EntryLayout>

<style>
  .note-source {
    font-size: var(--t-sm);
    color: var(--c-ink-faint);
    margin-block-end: var(--s-4);
  }
</style>
