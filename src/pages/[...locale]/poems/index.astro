---
import ListPage from '@layouts/ListPage.astro';
import { localePaths } from '@i18n/paths';
import { getEntries, paginate } from '@lib/content';
import { useTranslations } from '@i18n/utils';
import type { Locale } from '@config/site';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const entries = await getEntries('poems', { lang: locale, featuredFirst: true });
const page = paginate(entries, 1, '/poems');
---

<ListPage
  locale={locale}
  collection="poems"
  page={page}
  title={t('section.poems')}
  lead={t('poems.lead')}
  basePath="/poems"
/>
