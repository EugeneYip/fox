---
import { render, getEntry, type CollectionEntry } from 'astro:content';
import Base from '@layouts/Base.astro';
import { entryPaths } from '@i18n/paths';
import { getEntries, getNeighbors, getTranslations, transitionName } from '@lib/content';
import { useTranslations, localizePath } from '@i18n/utils';
import { formatDate, isoDate } from '@lib/dates';
import { privacy } from '@config/privacy';
import { youtubeId } from '@lib/syndication';
import type { Locale } from '@config/site';
import CoverImage from '@components/content/CoverImage.astro';
import PoemBlock from '@components/content/PoemBlock.astro';
import VideoFacade from '@components/content/VideoFacade.astro';
import TagList from '@components/ui/TagList.astro';
import FoxSeal from '@components/fox/FoxSeal.astro';

export async function getStaticPaths() {
  return entryPaths(await getEntries('poems'));
}

const { entry, locale } = Astro.props as { entry: CollectionEntry<'poems'>; locale: Locale };
const { Content } = await render(entry);
const t = useTranslations(locale);
const neighbors = await getNeighbors('poems', entry);
/*
 * 這一篇真的有哪幾種語言。`getTranslations()`（靠 `translationKey` 串同一篇的
 * 不同語言版本）從第一圈就寫好了，但**從來沒有人用過** —— 第 7 輪（第十一圈）
 * 量到語言鈕與 hreflang 都指向不存在的網址，才把它接上。
 */
const availableLocales = [locale, ...(await getTranslations('poems', entry)).map((tr) => tr.lang)];

/*
 * 用 getEntry 逐一取，而不是 getEntries。
 * getEntries 回傳的是「所有 collection 的聯集」型別，拿不到 data.poem；
 * getEntry 保留了 reference 上的 collection 資訊，型別才會準。
 */
const related = (
  await Promise.all(entry.data.related.map((ref) => getEntry(ref)))
).filter((r): r is CollectionEntry<'poems'> => Boolean(r));

/*
 * 取影片 ID 的那一段 2026-09-11 搬到 `@lib/syndication` 了 ——
 * 搜尋索引與合併 feed 也要用同一個判斷（「站上已經有這支影片了嗎」），
 * 三個地方各寫一份的話，多支援一種網址形式就會只改到一個。
 */
const videoId = youtubeId(entry.data.videoUrl);
const description =
  entry.data.description ??
  `${entry.data.poem.author}〈${entry.data.poem.title}〉—— ${entry.data.plain?.slice(0, 60) ?? ''}`;
---

<Base
  locale={locale}
  availableLocales={availableLocales}
  title={`${entry.data.poem.title}・${entry.data.poem.author}`}
  description={description}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  class="wrap--content"
>
  {entry.data.cover && <CoverImage src={entry.data.cover} alt={entry.data.coverAlt} width={760} />}

  <PoemBlock
    transitionName={transitionName('poems', entry.id)}
    poem={entry.data.poem}
    plain={entry.data.plain}
    annotations={entry.data.annotations}
    vertical={entry.data.vertical}
    locale={locale}
  />

  {/*
    「聽朗讀」與「狐狸說」並排 —— 站主 2026-09-09 要的版面。

    寬螢幕：影片在左、她的話在右，兩塊都接在白話底下。
    窄螢幕：疊起來，順序是白話 → 聽朗讀 → 狐狸說。

    DOM 順序就是窄螢幕的順序（影片在前），寬螢幕只是把它擺到第一欄 ——
    這樣鍵盤與螢幕閱讀器走到的順序，跟兩種寬度下看到的順序都一致，
    不必用 `order` 去搬（那會讓兩者對不上）。

    左欄夾在 19rem：站主要求影片那一欄不能超過一半，否則右邊那一欄
    會窄到跟手機一樣。斷點 48rem 上內容欄約 691px，19rem 是 44%。
  */}
  {(videoId || entry.body?.trim()) && (
    <div class="poem-page__pair">
      {videoId && (
        <section class="poem-page__section poem-page__listen" aria-label={t('poem.listen')}>
          <h2 class="poem-page__section-title ui">{t('poem.listen')}</h2>
          {/*
            iframe 的 title 跟底下 VideoFacade 的對齊 ——〈詩名〉作者。
            第 3 輪（第十四圈）比對時發現同一件事的兩條路寫法不同：
            這一條沒有補書名號，另一條有。**這條路現在走不到**
            （`allowThirdPartyEmbeds` 翻成 true 會被 audit:privacy 當場擋下，
            第 5 輪〔第十一圈〕實測過），所以這個改動沒辦法在產出上驗證 ——
            但留著兩種寫法更糟。
          */}
          {privacy.allowThirdPartyEmbeds ? (
            <div class:list={['poem-page__embed', entry.data.videoPortrait && 'poem-page__embed--portrait']}>
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
                title={`〈${entry.data.poem.title}〉${entry.data.poem.author}`}
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin"
              />
            </div>
          ) : (
            <VideoFacade
              videoId={videoId}
              title={`〈${entry.data.poem.title}〉${entry.data.poem.author}`}
              locale={locale}
              portrait={entry.data.videoPortrait}
              verse={
                /*
                 * 詩的首句 —— 自己畫的封面把它題成一幅條幅，
                 * 理由見 VideoFacade 的 `verse`。
                 *
                 * 註解寫在**大括號裡面**。這裡改對了兩次：
                 * 夾在屬性之間、以及當成三元運算子分支裡的兄弟節點，
                 * 兩種 `astro build` 都吃得下去，`astro check` 會噴
                 * 五、六個 ts 錯誤，而且指的行號跟真正的問題差很遠
                 *（「section 沒有結束標籤」指到 20 行以外）。
                 * 這個檔案只有 `npm run check` 會擋，build 不會。
                 */
                entry.data.poem.original
                  .split('\n')
                  .map((line) => line.trim())
                  .find(Boolean)
              }
            />
          )}
        </section>
      )}

      {entry.body?.trim() && (
        <section class="poem-page__section poem-page__thoughts" aria-label={t('poem.thoughts')}>
          <h2 class="poem-page__section-title ui">{t('poem.thoughts')}</h2>
          <div class="prose"><Content /></div>
        </section>
      )}
    </div>
  )}

  {/*
    讀音放在最底部 —— 站主 2026-09-09 要的位置。
    需要的人會找下來，不需要的人不會被它擋在詩跟她的話中間。

    樣式寫在這一頁的 <style> 裡而不是另開一個元件：新開元件會多一個
    內嵌 <style>，而 CSP 雜湊是 63 頁**共用**的預算（現在 36／41）。
    這一區只有詩頁用得到，不值得花掉那一格。
  */}
  {entry.data.readings.length > 0 && (
    <section class="poem-page__section" aria-label={t('poem.readings')}>
      <h2 class="poem-page__section-title ui">{t('poem.readings')}</h2>
      <ul class="poem-page__readings" lang="zh-Hant">
        {entry.data.readings.map((r) => (
          <li>
            <span class="poem-page__reading-char">{r.char}</span>
            <span class="poem-page__reading-zhuyin">{r.zhuyin}</span>
            {/* 拼音是拉丁字母拼的官話，標成 zh-Latn-pinyin 螢幕閱讀器才不會用中文語音唸它 */}
            <span class="poem-page__reading-pinyin" lang="zh-Latn-pinyin">{r.pinyin}</span>
            {r.homophone && <span class="poem-page__reading-same faint">同「{r.homophone}」</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <footer class="poem-page__foot">
    <FoxSeal char="狐" size={34} />
    <time class="ui faint" datetime={isoDate(entry.data.publishedAt)}>
      {formatDate(entry.data.publishedAt, locale)}
    </time>
    <TagList tags={entry.data.tags} locale={locale} />
  </footer>

  {related.length > 0 && (
    <section class="poem-page__section" aria-label={t('poem.related')}>
      <h2 class="poem-page__section-title ui">{t('poem.related')}</h2>
      <ul class="poem-page__related ui">
        {related.map((r) => (
          <li>
            <a href={localizePath(`/poems/${r.id}`, locale)}>
              〈{r.data.poem.title}〉<span class="faint">{r.data.poem.author}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(neighbors.newer || neighbors.older) && (
    <nav class="poem-page__nav ui" aria-label={t('nav.adjacent')}>
      {neighbors.newer ? (
        <a href={localizePath(`/poems/${neighbors.newer.id}`, locale)}>
          <span class="faint"><span aria-hidden="true">←</span> {t('list.newer')}</span>
          <span>〈{neighbors.newer.data.poem.title}〉</span>
        </a>
      ) : <span />}
      {neighbors.older && (
        <a class="poem-page__nav-end" href={localizePath(`/poems/${neighbors.older.id}`, locale)}>
          <span class="faint">{t('list.older')} <span aria-hidden="true">→</span></span>
          <span>〈{neighbors.older.data.poem.title}〉</span>
        </a>
      )}
    </nav>
  )}
</Base>

<style>
  /*
   * 兩塊並排。只有一塊的時候（沒影片、或沒寫狐狸說）那一塊佔滿整列 ——
   * 不然它會被關在 19rem 的左欄裡，變成一條又窄又長的字。
   */
  .poem-page__pair {
    display: grid;
    gap: var(--s-6);
    margin-block-start: var(--s-8);
  }

  .poem-page__pair > .poem-page__section {
    margin-block-start: 0;
  }

  @media (min-width: 48rem) {
    .poem-page__pair {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: var(--s-7);
      align-items: start;
    }

    .poem-page__pair > .poem-page__section:only-child {
      grid-column: 1 / -1;
    }
  }

  .poem-page__section {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--border-thin);
  }

  .poem-page__section-title {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    color: var(--c-ink-faint);
    text-transform: uppercase;
    margin-block-end: var(--s-4);
  }

  .poem-page__embed {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  /* 直版影片。數字跟 VideoFacade 的 .facade--portrait 是同一組
     這條路現在走不到（見上面那段註解），但兩邊長得不一樣更糟 */
  .poem-page__embed--portrait {
    aspect-ratio: 9 / 16;
    inline-size: min(17.5rem, 100%);
    margin-inline: auto;
  }

  .poem-page__embed iframe {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  /*
   * ── 讀音一條一條往下排，欄寬只用掉三分之一 ──────────
   *
   * 2026-09-11 在瀏覽器裡看到的：一條讀音（字、注音、拼音、同音字）
   * 佔 244px，而這一欄有 720px —— 三條讀音疊成一長條，右邊三分之二空著，
   * 讀起來像一段沒排完的東西，而不是一張小表。
   *
   * 改成放得下就並排：`auto-fill` ＋ `minmax(15rem, 1fr)`。
   * 寬螢幕一行放兩到三條、窄螢幕自動回到一條，不需要任何 media query。
   * 用 `auto-fill` 不用 `auto-fit`：只有一條讀音時 `auto-fit` 會把那一軌
   * 拉成滿版，一個字後面跟著一大片空白更怪。
   */
  .poem-page__readings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--s-3) var(--s-6);
  }

  .poem-page__readings li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    margin: 0;
  }

  .poem-page__reading-char {
    flex: none;
    inline-size: 1.8em;
    font-family: var(--f-serif);
    font-size: var(--t-lg);
    line-height: 1;
  }

  /*
   * 注音與拼音各給一個最小寬度，兩欄才對得齊。
   * 不用 grid 是為了窄螢幕 —— grid 要對齊得讓 <li> 變成 display: contents，
   * 而那會把清單項目從無障礙樹上拿掉；用 flex ＋ min-inline-size
   * 對齊效果一樣，放不下時還會自己換行。
   */
  .poem-page__reading-zhuyin {
    flex: none;
    min-inline-size: 4.5em;
    font-size: var(--t-sm);
    letter-spacing: 0.08em;
  }

  .poem-page__reading-pinyin {
    flex: none;
    min-inline-size: 4em;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }

  .poem-page__reading-same { font-size: var(--t-xs); }

  .poem-page__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-6);
    border-block-start: var(--border-thin);
  }

  .poem-page__related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .poem-page__related li { margin: 0; }

  .poem-page__related a {
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .poem-page__related a:hover { color: var(--c-flame-ink); }

  .poem-page__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: var(--border-thin);
  }

  .poem-page__nav a {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .poem-page__nav a:hover { color: var(--c-flame-ink); }

  .poem-page__nav-end {
    text-align: end;
    grid-column: 2;
  }

  @media (max-width: 34rem) {
    .poem-page__nav { grid-template-columns: 1fr; }
    .poem-page__nav-end { grid-column: 1; text-align: start; }
  }
</style>
