---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/layout/PageHeader.astro';
import { localePaths } from '@i18n/paths';
import { useTranslations, localizePath } from '@i18n/utils';
/*
 * ── 對外連結的 rel 只能有一個來源 ──────────
 *
 * 這裡原本寫死 `rel="noopener noreferrer"`，而站上其他八處都用
 * `externalLinkRel`（`privacy.strictReferrerPolicy` 一關就會變成只有 noopener）。
 *
 * 第 5 輪（第三十四圈）量到：把那個開關關掉，44 頁裡 58 個外部連結全部
 * 掉了 noreferrer，**只有搜尋結果還帶著** —— 方向上是比較保守沒錯，
 * 但那代表同一個隱私設定在站上有兩個答案，而其中一個不看開關。
 */
import { externalLinkRel } from '@config/privacy';
import { getSyndication } from '@lib/syndication';
import { getTagCloud } from '@lib/content';
import type { Locale } from '@config/site';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
/* 只為了知道索引裡會出現哪些平臺代號，好在結果列上顯示它們的名字 */
const syndicated = await getSyndication();

/*
 * ── 還沒打字的時候，這一頁是空的 ────────────────────
 *
 * 2026-09-11 在瀏覽器裡看到的：輸入框底下**有 570px 什麼都沒有**，
 * 然後就是頁尾。一個讀者到這裡，除了那句「可以找標題、內文、標籤」之外
 * 沒有任何線索 —— 不知道站上有什麼，也不知道該打什麼。
 *
 * 放幾個真的入口，不是裝飾：取站上**出現次數最多**的幾個標籤
 * （`getTagCloud()` 就是 `/tags` 在用的那一支，已經按次數排好），
 * 做成 `?q=` 的連結。這一頁本來就會讀 `?q=`，所以按下去就是一次真的搜尋。
 *
 * 六個是看版面訂的：一行放得下、又足以看出站上寫的是哪幾類東西。
 * 標籤是從內容長出來的，所以這份清單會自己跟著站長大 —— 不用維護。
 */
const suggestions = (await getTagCloud(locale)).slice(0, 6);

/*
 * ── 搜不到的時候，英文讀者不知道為什麼 ──────────
 *
 * 第 6 輪（第三十三圈）量的：索引裡 14 筆**全部是 zh-TW**，而 `score()`
 * 只看 title／tags／description／body 四個欄位 —— 這四個欄位裡含有拉丁字母的
 * 只有 1 筆。實測 11 個英文讀者會打的字（moon、li bai、poetry、autumn、
 * du fu⋯⋯），**10 個回 0 筆**。
 *
 * 而 `search.hint` 對他說的是「Looks through titles, body text, tags, and
 * poets’ names」—— 一個英文讀者讀完這句，理所當然會打「Li Bai」。
 * 打完得到的是「No matches found.」，沒有任何一個字告訴他原因。
 *
 * 站上每一個空的英文頁面都已經接好這件事了（`/en`、`/en/poems`、
 * `/en/writing`、`/en/notes`、`/en/archive`、`/en/tags` 都會說
 * 「There are N in Chinese →」，第 3 輪〔第十八圈〕加的）。
 * **只有搜尋沒有** —— 偏偏那是他唯一主動做了什麼的地方。
 *
 * 這裡不另外寫一句文案，直接沿用 `list.otherLang`：同一個約定只有一種說法，
 * 而且它已經翻好、也已經有單複數。
 */
const otherLocale: Locale = locale === 'zh-TW' ? 'en' : 'zh-TW';

/*
 * 文案在 build 時就取好，透過 data 屬性交給前端。
 *
 * 原本 client script 裡自己抄了一份 STRINGS，結果同樣的句子存在兩個地方
 * （ui.ts 與這支腳本），改一邊另一邊不會跟著動；而且 loading / failed
 * 兩句只存在腳本裡，從 ui.ts 完全看不到它們的存在。
 *
 * count 的單複數也一起在這裡處理好 —— t() 會依 n 挑 _one，
 * 前端只要把 {n} 換掉就行，不用再懂一次複數規則。
 */
const strings = JSON.stringify({
  none: t('search.noResults'),
  loading: t('search.loading'),
  failed: t('search.failed'),
  // n = 1 讓 t() 挑 _one，並且直接把 1 代進去（這句永遠只用在 n === 1）
  countOne: t('search.resultCount', { n: 1 }),
  // 不傳 vars，才會拿到還留著 {n} 的樣板讓前端自己代入。
  // 傳 { n: 0 } 的話 t() 會當場把 {n} 換成 0，前端再也換不掉，永遠顯示「0 個結果」。
  countMany: t('search.resultCount'),
  /* 跟 countOne／countMany 同一個手法：一句代好 1，一句留著 {n} 給前端代 */
  otherLangOne: t('list.otherLang', { n: 1 }),
  otherLangMany: t('list.otherLang'),
  otherLangHref: localizePath('/archive', otherLocale),
  /* 前端要拼 <a>，rel 從同一個常數來，不要在腳本裡再寫一次 */
  externalRel: externalLinkRel,
  locale,
  /*
   * 結果那一行的「類型」。第 3 輪（第十一圈）真的去搜了一次才看到：
   * 這裡原本直接印索引裡的 `k`，而 `k` 是**內部代號** ——
   * 中文頁的搜尋結果會寫「posts · 翻譯 詩詞 方法」「notes · 雜記」
   * 「youtube · 詩詞 朗讀」。站上其他地方（EntryCard）早就有翻譯了。
   *
   * 索引只有一份、兩種語言共用，所以標籤不能放進索引裡（會變成兩份），
   * 要在這裡按頁面的語言取好再交給前端。
   *
   * 平臺只放**索引裡真的會出現的那幾個**，不是整份平臺目錄 ——
   * 那會把 24 個名字塞進每一頁的搜尋頁。
   */
  kinds: {
    posts: t('type.post'),
    poems: t('type.poem'),
    notes: t('type.note'),
    ...Object.fromEntries(
      [...new Map(syndicated.map((i) => [i.platform.id, i.platform])).values()].map((p) => [
        p.id,
        p.name[locale] ?? p.name['zh-TW'],
      ]),
    ),
  },
});
---

<Base locale={locale} title={t('search.title')} noindex class="wrap--content">
  <PageHeader title={t('search.title')} lead={t('search.hint')} />

  <form class="search" role="search" data-search data-strings={strings}>
    <label class="sr-only" for="q">{t('search.title')}</label>
    <input
      id="q"
      type="search"
      name="q"
      class="search__input"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
    />
  </form>

  <p class="search__status ui faint" data-search-status aria-live="polite"></p>
  <ol class="search__results" data-search-results></ol>

  {/*
    放在結果**後面**是刻意的：底下那條 CSS 用
    `.search__results:not(:empty) ~ .search__start` 把它藏起來 ——
    有結果就不再指路，而兄弟選擇器只看得到後面的元素。
    這樣不需要任何一行 JavaScript（這一頁的內嵌腳本已經 4.3 KB）。
  */}
  {suggestions.length > 0 && (
    <p class="search__start ui">
      <span class="search__start-label faint">{t('search.startWith')}</span>
      {suggestions.map((s) => (
        <a href={`?q=${encodeURIComponent(s.tag)}`}>{s.tag}</a>
      ))}
    </p>
  )}

  {/* JavaScript 關掉時至少告訴使用者發生什麼事，而不是給一個死掉的輸入框 */}
  <noscript>
    <p class="muted">
      {t('search.noJs', { archive: t('archive.title'), tags: t('tags.title') })}
    </p>
  </noscript>
</Base>

<style>
  .search__input {
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    font-size: var(--t-md);
    font-family: var(--f-serif);
    background: var(--c-bg-raised);
    /* 輸入框空白時，這條線是唯一在說「這裡可以打字」的東西，需要 3:1 */
    border: 1px solid var(--c-edge);
    border-radius: var(--r-md);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .search__input:focus {
    border-color: var(--c-flame);
    outline: none;
  }

  .search__input:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .search__status {
    margin-block-start: var(--s-3);
    font-size: var(--t-xs);
    min-block-size: 1.2em;
  }

  /*
   * 入口那一列。樣子跟標籤的籤條一致（方角、左邊一道苔色的邊），
   * 但這裡是動詞不是名詞 —— 按下去會搜尋，不是去標籤頁。
   */
  .search__start {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-3);
    margin-block-start: var(--s-6);
  }

  .search__start-label { flex: none; }

  .search__start a {
    font-size: var(--t-xs);
    padding: 0.2em 0.7em;
    border: 0;
    border-inline-start: 2px solid var(--c-moss);
    background: var(--c-bg-sunken);
    color: var(--c-ink-soft);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .search__start a:hover,
  .search__start a:focus-visible {
    border-inline-start-color: var(--c-flame);
    background: var(--c-flame-wash);
    color: var(--c-flame-ink);
  }

  /* 有結果就不用再指路了 */
  .search__results:not(:empty) ~ .search__start { display: none; }

  .search__results {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }

  .search__results :global(li) {
    padding-block: var(--s-4);
    border-block-end: var(--border-thin);
    margin: 0;
  }

  .search__results :global(a) {
    font-size: var(--t-md);
    font-weight: 600;
    text-decoration: none;
  }

  .search__results :global(a:hover) { color: var(--c-flame-ink); }

  .search__results :global(.res__meta) {
    display: block;
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
    margin-block-start: var(--s-1);
  }

  /* 摘要會換行（六筆結果有五筆兩行），所以用段落的行距 */
  .search__results :global(.res__snippet) {
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
    line-height: var(--lh-body);
    margin-block-start: var(--s-2);
  }

  .search__results :global(mark) {
    background: var(--c-selection);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.1em;
  }
</style>

<script>
  interface IndexItem {
    t: string; u: string; l: string; k: string;
    d?: string; g?: string; b?: string; x?: 1;
  }

  /*
   * 全部包在 init 裡，參數是「已確定存在」的元素。
   * 如果在外層用 if 擋掉 null 再直接用，TypeScript 不會把縮小後的型別
   * 帶進後面宣告的函式裡，會一路報 possibly null。傳參數最乾淨。
   */
  function init(
    form: HTMLFormElement,
    input: HTMLInputElement,
    status: HTMLElement,
    results: HTMLOListElement,
  ) {
  interface Strings {
    none: string;
    loading: string;
    failed: string;
    countOne: string;
    countMany: string;
    otherLangOne: string;
    otherLangMany: string;
    otherLangHref: string;
    externalRel: string;
    locale: string;
    kinds: Record<string, string>;
  }
  const s: Strings = JSON.parse(form.dataset.strings ?? '{}');
  const count = (n: number) => (n === 1 ? s.countOne : s.countMany).replace('{n}', String(n));

  let index: IndexItem[] | null = null;
  let loading: Promise<void> | null = null;

  function ensureIndex(): Promise<void> {
    if (index) return Promise.resolve();
    if (loading) return loading;
    status.textContent = s.loading;
    loading = fetch('/search-index.json')
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((data: { items: IndexItem[] }) => {
        index = data.items;
        status.textContent = '';
      })
      .catch(() => {
        status.textContent = s.failed;
      });
    return loading;
  }

  /**
   * 中文沒有空格分詞，所以不做斷詞，直接做子字串比對。
   * 英文用空白切成多個詞，全部都要命中（AND）。
   *
   * （原本寫「英文與日文用空白切成多個詞」。兩個地方不對：這個站沒有日文，
   * 而且日文本來就不用空白分詞 —— 它跟中文一樣走上面那條路。
   * 第 3 輪〔第三十一圈〕改掉。）
   */
  function score(item: IndexItem, terms: string[]): number {
    const title = item.t.toLowerCase();
    const tags = (item.g ?? '').toLowerCase();
    const desc = (item.d ?? '').toLowerCase();
    const body = (item.b ?? '').toLowerCase();

    let total = 0;
    for (const term of terms) {
      let hit = 0;
      if (title.includes(term)) hit += 10;
      if (tags.includes(term)) hit += 6;
      if (desc.includes(term)) hit += 3;
      if (body.includes(term)) hit += 1;
      if (hit === 0) return 0;      // 有一個詞沒中就整筆不算
      total += hit;
    }
    // 同分時偏好站內內容，外站的排後面
    return total + (item.x ? 0 : 0.5);
  }

  function escapeHtml(text: string): string {
    return text.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
    );
  }

  /** 在摘要裡把命中的詞標起來，並且以第一個命中處為中心裁切 */
  function snippet(item: IndexItem, terms: string[]): string {
    const source = item.d || item.b || '';
    if (!source) return '';
    const lower = source.toLowerCase();
    const at = Math.max(0, terms.map((t) => lower.indexOf(t)).filter((i) => i >= 0)[0] ?? 0);
    const start = Math.max(0, at - 40);
    let text = escapeHtml(source.slice(start, start + 160));
    if (start > 0) text = '…' + text;
    if (start + 160 < source.length) text += '…';

    for (const term of terms) {
      if (!term) continue;
      const safe = escapeHtml(term).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      text = text.replace(new RegExp(safe, 'gi'), (m) => `<mark>${m}</mark>`);
    }
    return text;
  }

  function render(query: string) {
    const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
    results.innerHTML = '';

    if (terms.length === 0) {
      status.textContent = '';
      return;
    }

    /*
     * 索引不在的時候**不要碰 status**。
     *
     * 這一行原本是 `terms.length === 0 || !index` 一起清空，而
     * `ensureIndex()` 的 `.catch()` 是這樣寫的：
     *
     *     .catch(() => { status.textContent = s.failed; })
     *
     * catch 之後 promise 是**完成**的，所以後面的
     * `.then(() => render(...))` 照樣跑，而 render 進來時 index 仍然是
     * null —— 於是剛寫好的「索引載入失敗，請重新整理。」被清成空字串。
     *
     * 第 6 輪（第十一圈）把 fetch 換成一定失敗的版本實測：使用者看到的是
     * **一片空白** —— 打了字、沒有結果、也沒有任何訊息。
     * `search.failed` 這句話兩種語言都翻好了，而它到不了畫面上。
     */
    if (!index) return;

    const hits = index
      .map((item) => ({ item, score: score(item, terms) }))
      .filter((h) => h.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 40);

    status.textContent = hits.length ? count(hits.length) : s.none;

    /*
     * 一筆都沒有、而且索引裡**這個語言一筆都沒有**的時候，指路。
     *
     * 條件挑「這個語言 0 筆」而不是「這次查不到」—— 中文讀者搜一個
     * 站上沒寫過的詞不該被叫去英文版，而英文讀者現在無論打什麼都該被指路。
     * 有了英文內容之後這一行會自己消失，不用記得回來拿掉。
     */
    if (!hits.length) {
      const mine = index.filter((i) => i.l === s.locale).length;
      const other = index.length - mine;
      if (mine === 0 && other > 0) {
        const link = document.createElement('a');
        link.className = 'ui';
        link.href = s.otherLangHref;
        link.textContent =
          (other === 1 ? s.otherLangOne : s.otherLangMany.replace('{n}', String(other))) + ' ';
        /* 箭頭是裝飾，不進可及名稱 —— 跟 ListPage 的那一個一樣 */
        const arrow = document.createElement('span');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        link.append(arrow);
        status.append(' ', link);
      }
    }

    for (const { item } of hits) {
      const li = document.createElement('li');
      const external = item.x === 1;
      li.innerHTML = `
        <a href="${escapeHtml(item.u)}"${external ? ` target="_blank" rel="${escapeHtml(s.externalRel)}"` : ''}>
          ${escapeHtml(item.t)}${external ? ' <span aria-hidden="true">↗</span>' : ''}
        </a>
        <span class="res__meta">${escapeHtml(s.kinds[item.k] ?? item.k)}${item.g ? ' · ' + escapeHtml(item.g) : ''}</span>
        ${snippet(item, terms) ? `<p class="res__snippet">${snippet(item, terms)}</p>` : ''}
      `;
      results.append(li);
    }
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      void ensureIndex().then(() => render(input.value));
    }, 120);
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void ensureIndex().then(() => render(input.value));
  });

  // 網址帶 ?q= 時直接搜（方便從別的地方連過來）
  const preset = new URLSearchParams(location.search).get('q');
  if (preset) {
    input.value = preset;
    void ensureIndex().then(() => render(preset));
  }
  }

  const form = document.querySelector<HTMLFormElement>('[data-search]');
  const input = document.querySelector<HTMLInputElement>('#q');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLOListElement>('[data-search-results]');

  if (form && input && status && results) init(form, input, status, results);
</script>
