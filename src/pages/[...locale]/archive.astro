---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/layout/PageHeader.astro';
import { localePaths } from '@i18n/paths';
import { groupByYear, entryUrl } from '@lib/content';
import { useTranslations, localizePath } from '@i18n/utils';
import { formatDate, isoDate } from '@lib/dates';
import type { Locale } from '@config/site';
import EmptyState from '@components/ui/EmptyState.astro';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const years = await groupByYear(locale);
const total = years.reduce((n, [, items]) => n + items.length, 0);

const TYPE_MARK = { posts: '文', poems: '詩', notes: '札' } as const;

// 空的時候指路 —— 理由與寫法同 ListPage.astro，這一頁沒有走那個版型
const otherLocale: Locale = locale === 'zh-TW' ? 'en' : 'zh-TW';
const otherTotal =
  total === 0
    ? (await groupByYear(otherLocale)).reduce((n, [, items]) => n + items.length, 0)
    : 0;
---

<Base
  locale={locale}
  title={t('archive.title')}
  description={total > 0 ? t('meta.archive', { n: total }) : t('meta.empty')}
  class="wrap--content"
>
  <PageHeader title={t('archive.title')} lead={t('archive.lead')} count={t('list.count', { n: total })} />

  {/*
    每年用 div 而不是 section：一年一個地標太吵，
    而且年份的 h2 本來就能用標題導覽，不需要再多一層 landmark。
    註解放在 map 外面 —— 箭頭函式只能回傳一個表達式，
    註解跟元素並列會變成兩個節點，直接語法錯誤。
  */}
  {years.length > 0 ? (
    years.map(([year, items]) => (
      <div class="arc__year">
        <h2 class="arc__year-label ui">{year}</h2>
        <ol class="arc__list">
          {items.map(({ collection, entry }) => (
            <li class="arc__item">
              <time class="arc__date ui faint" datetime={isoDate(entry.data.publishedAt)}>
                {formatDate(entry.data.publishedAt, locale).replace(/^\d{4}年?\s?/, '')}
              </time>
              <span class="arc__mark" data-type={collection} aria-hidden="true">
                {TYPE_MARK[collection]}
              </span>
              <a href={localizePath(entryUrl(collection, entry), locale)}>
                {'poem' in entry.data ? `〈${entry.data.poem.title}〉` : entry.data.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))
  ) : (
    <EmptyState title={t('list.empty')}>
      {/*
      不借 `home.emptyBody` —— 理由見 ListPage.astro 同一處的註解（第 6 輪〔第四十圈〕）。
      */}
      {otherTotal > 0 && (
        <a class="ui" href={localizePath('/archive', otherLocale)}>
          {t('list.otherLang', { n: otherTotal })}{' '}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </EmptyState>
  )}
</Base>

<style>
  .arc__year + .arc__year { margin-block-start: var(--s-7); }

  /*
   * ── 年份是這一頁的骨架，不該用最淡的那一階 ──────────
   *
   * 2026-09-11 在 1280px 上看到的：年份用的是 `--c-ink-faint` ——
   * 那一階是給日期、註記這種**小字**用的（三階是 15.74 → 7.40 → 4.94，
   * 它是最淡的一階）。結果是一個 --t-lg、粗體的標題，顏色卻比它底下
   * 每一篇的標題還淡：**負責分段的東西看起來比被分的東西不重要。**
   *
   * 改成 `--c-ink-soft`（7.40:1），並掛上站上分節標題共用的魚尾 ——
   * 「這裡換一段了」在全站就只有一種說法。
   * 不用 `--c-ink`：一頁上會重複出現好幾個年份，滿黑的話會蓋過內容。
   */
  .arc__year-label {
    font-size: var(--t-lg);
    font-weight: 600;
    color: var(--c-ink-soft);
    padding-block-end: var(--s-2);
    border-block-end: var(--border-thin);
    margin-block-end: var(--s-3);
  }

  .arc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .arc__item {
    display: grid;
    /*
     * 前兩欄用 `min(…, N%)` 而不是硬的 rem。
     *
     * 固定軌道不會讓步：容器再窄也一樣寬。而那個 rem 會跟著**使用者自己
     * 調大的瀏覽器預設字級**長大 —— 第 1 輪（第二十二圈）實測，
     * 視窗 320px、根字級 32px 時前兩欄吃掉 227px，只剩 93px 給詩題，
     * 於是〈靜夜思〉把整頁推出去 12px。
     *
     * 跟 PlatformGrid 的 `minmax(min(14rem, 100%), 1fr)` 是同一種修法。
     */
    /*
     * 第三軌是 `minmax(0, 1fr)` 不是 `1fr`。
     *
     * `1fr` 的自動最小值是 min-content，而 `word-break: keep-all` 之下
     * 一個**沒有標點的標題**（〈為什麼要有一個自己的地方〉）整串就是
     * 一個 min-content —— 320px 下那一軌被撐到 195px，整列溢出 16px。
     * `minmax(0, …)` 讓軌道可以縮，縮不下時才由 `overflow-wrap: break-word`
     * 把那個標題斷開。
     *
     * 這比全站用 `overflow-wrap: anywhere` 精準：那一版會讓**每一段文字**
     * 都提前用最後手段斷行，而最後手段的斷行不理會中文的行首禁則
     *（站主 2026-09-11 因此看到一個句號自己站一行）。
     */
    grid-template-columns: min(5.5rem, 30%) min(1.6rem, 10%) minmax(0, 1fr);
    gap: var(--s-2);
    align-items: baseline;
    padding-block: var(--s-3);
    /*
     * 往外咬一點，讓 hover 的底色比文字寬一些 —— 底色貼著字會顯得髒。
     * 用負的 margin 而不是加寬容器：這樣列表本身的對齊線不會動。
     */
    padding-inline: var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    border-radius: var(--r-md);
    transition: background var(--dur-fast) var(--ease);
  }

  /*
   * 整列有回應，不只標題換色。
   *
   * `:focus-within` 跟 `:hover` 一起寫：鍵盤 Tab 到那一列的連結時，
   * 看到的回饋要跟滑鼠一樣 —— 不然這個效果等於只給滑鼠使用者。
   * 動效的時長走 `--dur-fast`，`prefers-reduced-motion` 的全站區塊會關掉它。
   */
  .arc__item:hover,
  .arc__item:focus-within {
    background: var(--c-bg-sunken);
  }

  .arc__date {
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
  }

  .arc__mark {
    display: inline-grid;
    place-items: center;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    font-size: var(--t-xs);
    border-radius: var(--r-sm);
    background: var(--c-bg-sunken);
    color: var(--c-ink-faint);
    /*
     * ── 對齊第一行，不是對齊整列 ──────────────────────
     *
     * 本來是 `align-self: center`。標題只有一行時看不出差別，
     * 但第 3 輪（第五十四圈）拿一個 33 字的標題去量（站上最長的標題是 15 字，
     * 所以這種情況從來沒有出現過）：
     *
     *   1 行的標題   date 459　mark 458　title 457   ← 齊
     *   4 行的標題   date 334　**mark 368**　title 332   ← 標記掉了 34px
     *
     * 那一格是「這是哪一種內容」的標記，它屬於**日期那一行**；
     * 掉到整列的垂直中央就跟日期斷開了，讀起來像浮在標題中間。
     *
     * 用 `baseline`：這一列本來就是 `align-items: baseline`，
     * 而這個標記是 `inline-grid` ＋ `place-items: center`，
     * 它的基線就是裡面那個字的基線 —— 字級一變也會自己跟上。
     */
    align-self: baseline;
  }

  .arc__mark[data-type="poems"] {
    background: var(--c-flame-wash);
    color: var(--c-flame-ink);
  }

  .arc__item a {
    text-decoration: none;
    line-height: var(--lh-snug);
  }

  .arc__item a:hover { color: var(--c-flame-ink); }

  @media (max-width: 34rem) {
    .arc__item { grid-template-columns: min(4.5rem, 30%) min(1.6rem, 10%) minmax(0, 1fr); }
  }
</style>
