---
import Base from '@layouts/Base.astro';
import { localePaths } from '@i18n/paths';
import { site, DEFAULT_LOCALE, type Locale } from '@config/site';
import { useTranslations, localizePath, pick } from '@i18n/utils';
import { getAllWriting, getEntries, entryUrl } from '@lib/content';
import { getSyndication, getActivePlatforms } from '@lib/syndication';
import FoxMark from '@components/fox/FoxMark.astro';
import Foxfire from '@components/fox/Foxfire.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import EntryCard from '@components/ui/EntryCard.astro';
import EmptyState from '@components/ui/EmptyState.astro';
import SyndicationList from '@components/content/SyndicationList.astro';
import PlatformGrid from '@components/content/PlatformGrid.astro';

export const getStaticPaths = () => localePaths();

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const latest = await getAllWriting({ lang: locale, limit: 6 });
// 空的時候指路 —— 理由與寫法同 ListPage.astro。首頁是英文讀者看到的第一頁，
// 這裡不說，他就不會知道另一個語言有東西
const otherLocale: Locale = locale === 'zh-TW' ? 'en' : 'zh-TW';
const otherLatest = latest.length === 0 ? (await getAllWriting({ lang: otherLocale })).length : 0;
const elsewhere = await getSyndication({ limit: 5 });
const platforms = await getActivePlatforms();

const name = pick(site.name, locale) ?? site.name[DEFAULT_LOCALE];
const tagline = pick(site.tagline, locale) ?? '';
const gloss = pick(site.epigraph.gloss, locale) ?? '';

/*
 * 題辭逐句切開，一句一欄。
 *
 * 本來是靠 `max-inline-size` 剛好等於「五個字」，讓它自己斷在逗號上 ——
 * 那是碰運氣不是規則。2026-09-11 接出後兩句時當場破功：
 * 放寬到六個字之後，它斷成「青青子衿，悠」與「悠我心」。
 *
 * （`word-break` 在這裡是 `normal`，那是修「倒十字架」時定的：
 * WebKit 在直排底下對 `keep-all` 不產生斷點。所以斷在哪裡由字數決定，
 * 不由標點決定 —— 除非像現在這樣自己把句子分開。）
 */
const epigraphLines = (text: string) =>
  text.split(/(?<=，)/).map((line) => line.trim()).filter(Boolean);

/*
 * 題辭的出處連到站上那一首（`site.epigraph.poem`）。
 *
 * 起〈子衿〉那一篇的理由就是這個：站上天天有人看到那兩句，
 * 卻沒有一頁在講它。現在有了，出處就該是一扇門。
 *
 * **用查的，不是寫死一條網址。** `getEntries` 已經濾掉草稿，所以
 * 那一篇被改回 `draft: true` 或改了檔名的時候，這裡會查不到，
 * 出處就退回純文字 —— 不會在首頁留一個 404。
 *
 * 不加語言前綴是對的：那一篇是 `lang: zh-TW`，只存在於 `/poems/zi-jin`。
 * 英文首頁也連同一個網址（出處那一行本來就永遠是中文），
 * 所以 `<a>` 上標了 `hreflang` 說明「按下去會換成中文」。
 */
const epigraphPoem = site.epigraph.poem
  ? (await getEntries('poems')).find((e) => e.id === site.epigraph.poem)
  : undefined;
const epigraphHref = epigraphPoem ? entryUrl('poems', epigraphPoem) : undefined;
---

<Base locale={locale} bare>
  {/* 純排版分組，不需要變成地標 —— 裡面的 h1 已經是導覽用的錨點 */}
  <div class="hero">
    <Foxfire count={7} />

    <div class="wrap hero__inner">
      {/* 顏色套在外層容器上：Astro 的 scoped style 不會穿進子元件，
          但 color 會沿著 DOM 繼承下去，SVG 的 currentColor 就吃得到 */}
      <div class="hero__mark"><FoxMark size={76} variant="line" /></div>

      <h1 class="hero__name">{name}</h1>
      <p class="hero__tagline">{tagline}</p>

      <figure class="hero__epigraph">
        {/*
          引文與出處**永遠**是中文（那是《詩經》的原文與書名），跟頁面語言無關。
          出處這一行原本漏了 lang，英文版上螢幕閱讀器會用英文語音唸
          「《詩經・鄭風・子衿》」。用 zh-Hant 而不是 zh-Hant-TW —— 古典漢文
          不屬於任何一個地區。
        */}
        {/*
          點一下把〈子衿〉的後兩句接出來。

          為什麼是 `<details>` 而不是 `:hover`：手機沒有 hover。
          `<summary>` 本來就能用鍵盤走到、能點、能按空白鍵 ——
          換成 hover 的話這個互動在手機上等於不存在。

          `<details>` 放在 `<blockquote>` **裡面**不是外面：
          `<summary>` 只收 phrasing content，`<blockquote>` 是 flow，
          塞進去是不合法的 HTML。反過來包就兩邊都對。

          直排之下，接出來的那兩句會落在第一句的**左邊** ——
          那正是直排的下一行該在的位置，不必另外排。
        */}
        <blockquote lang="zh-Hant">
          <details class="epi">
            <summary class="epi__head">
              {epigraphLines(site.epigraph.text).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {/*
                    `lang` 標在**每一句**上，不是只標在外面的 `<blockquote>`。
                    繼承在語意上沒問題，但 `check:a11y` 的 `unlabelled-cjk`
                    是用「往前 1200 字元內有沒有 lang、中間不能有關閉標籤」
                    近似祖先的 —— 兄弟元素的 `</span>` 就把它擋住了。
                    標明白比依賴繼承可靠，別的工具也未必都做完整的祖先查詢。
                  */}
                  <span class="epi__line" lang="zh-Hant">{line}</span>
                </>
              ))}
            </summary>
            <span class="epi__more">
              {epigraphLines(site.epigraph.more).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  <span class="epi__line" lang="zh-Hant">{line}</span>
                </>
              ))}
            </span>
          </details>
        </blockquote>
        <figcaption>
          {epigraphHref ? (
            <a class="hero__source" href={epigraphHref} lang="zh-Hant" hreflang="zh-Hant-TW">
              {site.epigraph.source}
            </a>
          ) : (
            <span class="hero__source" lang="zh-Hant">{site.epigraph.source}</span>
          )}
          {locale !== 'zh-TW' && <span class="hero__gloss faint">{gloss}</span>}
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="wrap wrap--wide home">
    <section class="home__section" aria-label={t('home.latest')}>
      <SectionHeading
        title={t('home.latest')}
        href={localizePath('/archive', locale)}
        linkText={t('home.viewAll')}
        linkLabel={t('home.viewAllOf', { section: t('home.latest') })}
      />

      {latest.length > 0 ? (
        <div class="home__entries">
          {latest.map(({ collection, entry }) => (
            <EntryCard collection={collection} entry={entry} locale={locale} />
          ))}
        </div>
      ) : (
        <EmptyState title={t('home.emptyTitle')} body={t('home.emptyBody')}>
          {otherLatest > 0 && (
            <a class="ui" href={localizePath('/archive', otherLocale)}>
              {t('list.otherLang', { n: otherLatest })}{' '}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </EmptyState>
      )}
    </section>

    <section class="home__section" aria-label={t('home.elsewhere')}>
      <SectionHeading
        title={t('home.elsewhere')}
        href={localizePath('/elsewhere', locale)}
        linkText={t('home.viewAll')}
        linkLabel={t('home.viewAllOf', { section: t('home.elsewhere') })}
      />

      {platforms.length > 0 && <PlatformGrid entries={platforms} locale={locale} />}

      {elsewhere.length > 0 && (
        <div class="home__syndication">
          <SyndicationList items={elsewhere} locale={locale} />
        </div>
      )}

      {platforms.length === 0 && elsewhere.length === 0 && (
        <EmptyState title={t('elsewhere.notSyncedYet')} />
      )}
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-block-end: var(--border-thin);
    /* 淡淡的暖光從左上灑下來，像燈下讀書 */
    background:
      radial-gradient(70% 60% at 22% 0%, var(--c-flame-wash), transparent 68%),
      var(--c-bg);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-4);
    padding-block: clamp(var(--s-8), 12vh, var(--s-10));
  }

  .hero__mark { color: var(--c-flame); }

  .hero__name {
    font-size: var(--t-display);
    font-weight: 600;
    letter-spacing: 0.1em;
    /* 中文標題加了字距後右邊會多出一格，補回來才對齊 */
    margin-inline-end: -0.1em;
    line-height: 1.1;
  }

  .hero__tagline {
    font-size: var(--t-md);
    color: var(--c-ink-soft);
    letter-spacing: 0.04em;
  }

  .hero__epigraph {
    margin: var(--s-6) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }

  /*
   * ── 題辭改成直排 ──────────────────────────────────
   *
   * 《子衿》這兩句本來就是直著寫的。橫排的時候它跟底下的標語、
   * 上面的標題排成同一個方向，整個首頁只有一種軸 ——
   * 而這是一個直排詩詞的站，首頁卻沒有一個字是直的。
   *
   * `max-inline-size` 在 `vertical-rl` 底下是**一行的長度（高度）**，
   * 所以 6.4em 的意思是「一列放得下五個字」——「青青子衿，」剛好五格
   * （全形逗號佔一格，而它照行首禁則不會被丟到下一列的開頭），
   * 「悠悠我心」自己成為左邊那一列。兩列由右往左，跟古書一樣。
   *
   * 換別的句子也不會壞，只是換個地方折 —— 這裡沒有寫死字數。
   *
   * `margin-inline-end` 那一行不用改：它補的是 letter-spacing 在
   * **行末**多出來的那一格，而邏輯屬性在直排時自己就指到下方了。
   */
  .hero__epigraph blockquote {
    border: 0;
    padding: 0;
    font-size: var(--t-lg);
    color: var(--c-ink);
    letter-spacing: 0.2em;
    margin-inline-end: -0.2em;
    writing-mode: vertical-rl;
    /*
     * 欄長不再寫死。哪裡換欄由上面那個 `epigraphLines` 的 `<br>` 決定 ——
     * 一句一欄，跟字數無關。（本來是 `max-inline-size: 6.4em`
     * ＝「剛好放得下五個字」，靠的是運氣，接出後兩句就破功了。）
     */
    /* 兩列之間留一點氣口，不要黏在一起 */
    line-height: 2;
    /*
     * ── 直排底下一定要 `word-break: normal` ──────────────
     *
     * 2026-09-11 站主回報：這兩句變成一條直線，底下那行
     * 《詩經・鄭風・子衿》橫著穿過去，「像倒十字架」。
     *
     * 成因是同一天早上把 `overflow-wrap` 的保險從 `body` 上拿掉
     *（那是為了不讓標點落到行首，見 global.css）。在真的 WebKit 上量：
     * **`word-break: keep-all` 在 `vertical-rl` 底下根本不產生斷點** ——
     * 連「，」後面都不斷。九個字擠成一欄，超出盒子 112px 蓋到出處那一行。
     * 而且**縮盒子沒有用**：`max-inline-size` 改成 6.2em、5.5em，
     * 溢出反而變成 117px、135px —— 盒子變小，字一個都沒有讓。
     *
     * `word-break: normal` 量到的就是這一節註解描述的樣子：
     * 「青青子衿，」一欄、「悠悠我心」一欄，文字比盒子短 5px，
     * 而且「，」沒有被丟到左邊那一欄的開頭（`normal` 底下禁則是生效的，
     * 321 種寬度掃過去 0 個違規）。
     *
     * 所以上面那句「全形逗號佔一格，而它照行首禁則不會被丟到下一列的開頭」
     * 仍然成立 —— 只是**靠的是 `normal`，不是 `keep-all`**。
     */
    word-break: normal;
  }

  /*
   * ── 題辭的後兩句 ───────────────────────────────────
   *
   * 收起來時只有那兩句，跟以前一模一樣；點一下第二聯接在左邊。
   * 直排之下這是「下一行」該在的位置，所以版面不必另外排。
   *
   * 不畫三角形：`.prose details` 那個標記是給文章裡的補充用的，
   * 這裡是一句詩，旁邊掛一個記號會壞掉。改成**碰到才變色** ——
   * 不明說「可以點」，讓它像書上一處被翻得比較舊的地方。
   * （`list-style: none` ＋ `::-webkit-details-marker` 兩個都要，
   * 這個站的 `.prose details` 已經踩過一次。）
   */
  .epi {
    display: contents;
  }

  .epi__head {
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .epi__head::-webkit-details-marker {
    display: none;
  }

  .epi__head:hover,
  .epi__head:focus-visible {
    color: var(--c-flame-ink);
  }

  /* 接出來的那兩句比前兩句淡一點 —— 它是往下走的那一步，不是並列 */
  .epi__more {
    color: var(--c-ink-soft);
  }

  /* 一句不折 —— 跟詩頁的 `.poem__line` 同一個道理 */
  .epi__line {
    white-space: nowrap;
  }

  .hero__epigraph figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    color: var(--c-ink-faint);
  }

  .hero__gloss { max-inline-size: 38ch; }

  /* ── 首頁內容 ────────────────────────────────────── */

  .home {
    display: grid;
    gap: var(--s-9);
  }

  .home__section { min-inline-size: 0; }

  .home__syndication { margin-block-start: var(--s-6); }
</style>
